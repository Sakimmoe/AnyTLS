#!/usr/bin/env bash
# AnyTLS (sing-box) 一键管理脚本：安装/更新/查看/更改端口/更改密码/更改SNI/卸载
# 基于 sing-box 内置 anytls inbound，自签 CA + 证书固定
# 兼容 Debian/Ubuntu/CentOS，支持 amd64 / arm64

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

# ==================== 配置路径 ====================
CONFIG_DIR="/etc/anytls"
WORK_DIR="$CONFIG_DIR"
ANYTLS_SERVICE_NAME="anytls.service"
ANYTLS_SERVICE_FILE="/etc/systemd/system/${ANYTLS_SERVICE_NAME}"
CONFIG_JSON="${CONFIG_DIR}/config.json"
LIST_FILE="${CONFIG_DIR}/list"
CRON_AUTO="/etc/cron.d/anytls-auto-update"
CRON_CLEAN="/etc/cron.d/anytls-cleanup"
GITHUB_API="https://api.github.com/repos/SagerNet/sing-box/releases/latest"
TZ_DEFAULT="Asia/Shanghai"
SHELL_VERSION="1.0.5"
# 可选：如果将本脚本托管在 GitHub/Gist 等位置，在此填入 Raw 链接，在线一键安装时也能自动下载面板
SCRIPT_URL="${SCRIPT_URL:-""}"

# ==================== 颜色配置 ====================
Font="\033[0m"
Black="\033[30m"
Red="\033[31m"
Green="\033[32m"
Yellow="\033[33m"
Blue="\033[34m"
Magenta="\033[35m"
Cyan="\033[36m"
White="\033[37m"
BRed="\033[91m"
BGreen="\033[92m"
BYellow="\033[93m"
BCyan="\033[96m"
Bold="\033[1m"

OK="${Green}[OK]${Font}"
ERROR="${Red}[ERROR]${Font}"
WARN="${Yellow}[WARN]${Font}"
INFO="${Cyan}[INFO]${Font}"

print_ok()  { echo -e "${OK}${Blue} $1 ${Font}"; }
print_info(){ echo -e "${INFO}${Cyan} $1 ${Font}"; }
print_warn(){ echo -e "${WARN}${Yellow} $1 ${Font}"; }
print_err() { echo -e "${ERROR} ${BRed}$1${Font}"; }

judge() {
  if [[ $? -eq 0 ]]; then
    print_ok "$1 完成"
    sleep 0.5
  else
    print_err "$1 失败"
    exit 1
  fi
}

hr() { printf '%*s\n' 50 '' | tr ' ' '='; }

pause() { read -rp "按回车返回菜单..." _; }

ensure_root() {
  if [[ $EUID -ne 0 ]]; then
    clear
    print_err "必须使用 root 运行本脚本!"
    exit 1
  fi
}

# ==================== 状态检测 ====================
binary_exists() { [[ -x /usr/local/bin/sing-box ]]; }
service_exists() { [[ -f "$ANYTLS_SERVICE_FILE" ]]; }
is_installed()   { binary_exists || service_exists; }
is_active()      { systemctl is-active "$ANYTLS_SERVICE_NAME" >/dev/null 2>&1; }

get_local_version() {
  if binary_exists; then
    /usr/local/bin/sing-box version 2>/dev/null | awk '/version/{print $NF}' || echo "unknown"
  else
    echo "未安装"
  fi
}

get_remote_version() {
  curl -s --connect-timeout 10 --max-time 20 "$GITHUB_API" | jq -r '.tag_name' 2>/dev/null | sed 's/^v//' || echo ""
}

install_status_text() {
  if is_installed; then
    if is_active; then
      echo -e "${BGreen}已安装（运行中）${Font}"
    else
      if systemctl is-failed "$ANYTLS_SERVICE_NAME" >/dev/null 2>&1; then
        echo -e "${BYellow}已安装（上次启动失败）${Font}"
      else
        echo -e "${BYellow}已安装（已停止）${Font}"
      fi
    fi
  else
    echo -e "${BRed}未安装${Font}"
  fi
}

# ==================== 工具函数 ====================
random_port() { shuf -i 2000-65000 -n 1; }
gen_password(){ cat /proc/sys/kernel/random/uuid; }

valid_port() {
  local p="${1:-}"
  [[ "$p" =~ ^[0-9]+$ ]] && (( p >= 1 && p <= 65535 ))
}

is_port_used() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -tuln | awk '{print $5}' | grep -Eq "[:.]${port}([[:space:]]|$)"
  elif command -v lsof >/dev/null 2>&1; then
    lsof -i :"$port" -sTCP:LISTEN >/dev/null 2>&1
  else
    return 1
  fi
}

read_port_interactive() {
  local input current="${2:-}"
  while true; do
    if [[ -n "$current" ]]; then
      read -rp "回车保持当前端口 [${current}]，或输入新端口(1-65535): " input
      [[ -z "$input" ]] && { echo "$current"; return; }
    else
      read -t 15 -rp "回车或等待15秒为随机端口，或输入端口(1-65535): " input || true
      [[ -z "$input" ]] && input=$(random_port)
    fi

    if ! valid_port "$input"; then
      print_warn "端口不合法：$input"
      continue
    fi
    if is_port_used "$input"; then
      print_warn "端口 $input 已被占用"
      continue
    fi
    echo "$input"
    break
  done
}

get_ip() {
  local ip4 ip6
  ip4=$(curl -4 -s --max-time 5 https://api.ipify.org 2>/dev/null || true)
  [[ -n "$ip4" ]] && { echo "$ip4"; return; }
  ip6=$(curl -6 -s --connect-timeout 3 https://api64.ipify.org 2>/dev/null || true)
  [[ -n "$ip6" ]] && { echo "$ip6"; return; }
  echo "未知"
}

check_system_ip() {
  IPV4=$(curl -4 -s --max-time 5 https://api.ipify.org 2>/dev/null || echo "")
  IPV6=$(curl -6 -s --connect-timeout 3 https://api64.ipify.org 2>/dev/null || echo "")
  MAIN_IP=$([ -n "$IPV4" ] && echo "$IPV4" || echo "$IPV6")
}

get_arch() {
  case "$(uname -m)" in
    x86_64|amd64) echo "amd64" ;;
    aarch64|arm64) echo "arm64" ;;
    *) print_err "不支持的架构: $(uname -m)"; exit 1 ;;
  esac
}

# ==================== 证书生成 ====================
ssl_certificate() {
  local TLS_SERVER="$1"
  local CN_DOMAIN=$(awk -F . '{print $(NF-1)"."$NF}' <<< "$TLS_SERVER")
  mkdir -p "${CONFIG_DIR}/cert"

  if [[ ! -s "${CONFIG_DIR}/cert/ca.key" ]]; then
    print_info "生成 CA 私钥..."
    openssl ecparam -genkey -name prime256v1 -out "${CONFIG_DIR}/cert/ca.key"
  fi

  if [[ ! -s "${CONFIG_DIR}/cert/ca.crt" ]]; then
    print_info "生成 CA 根证书..."
    cat > "${CONFIG_DIR}/cert/ca.conf" <<EOF
[req]
distinguished_name = req_distinguished_name
x509_extensions = v3_ca
prompt = no
[req_distinguished_name]
CN = AnyTLS Root CA
[v3_ca]
basicConstraints = critical, CA:TRUE
keyUsage = critical, keyCertSign, cRLSign
EOF
    openssl req -new -x509 -days 36500 \
      -key "${CONFIG_DIR}/cert/ca.key" \
      -out "${CONFIG_DIR}/cert/ca.crt" \
      -config "${CONFIG_DIR}/cert/ca.conf"
    rm -f "${CONFIG_DIR}/cert/ca.conf"
  fi

  if [[ ! -s "${CONFIG_DIR}/cert/private.key" ]]; then
    print_info "生成服务器私钥..."
    openssl ecparam -genkey -name prime256v1 -out "${CONFIG_DIR}/cert/private.key"
  fi

  cat > "${CONFIG_DIR}/cert/server.conf" <<EOF
[req]
distinguished_name = req_distinguished_name
req_extensions = v3_req
prompt = no
[req_distinguished_name]
CN = ${CN_DOMAIN}
[v3_req]
subjectAltName = @alt_names
[alt_names]
DNS.1 = ${TLS_SERVER}
EOF

  openssl req -new \
    -key "${CONFIG_DIR}/cert/private.key" \
    -out "${CONFIG_DIR}/cert/server.csr" \
    -config "${CONFIG_DIR}/cert/server.conf"

  cat > "${CONFIG_DIR}/cert/ext.conf" <<EOF
basicConstraints = CA:FALSE
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = DNS:${TLS_SERVER}
EOF

  openssl x509 -req -days 36500 \
    -in "${CONFIG_DIR}/cert/server.csr" \
    -CA "${CONFIG_DIR}/cert/ca.crt" \
    -CAkey "${CONFIG_DIR}/cert/ca.key" \
    -CAcreateserial \
    -out "${CONFIG_DIR}/cert/cert.pem" \
    -extfile "${CONFIG_DIR}/cert/ext.conf"

  rm -f "${CONFIG_DIR}/cert/server.conf" "${CONFIG_DIR}/cert/server.csr" \
        "${CONFIG_DIR}/cert/ext.conf" "${CONFIG_DIR}/cert/ca.srl"
}

# ==================== 下载 sing-box ====================
download_singbox() {
  local DEST_BIN="${1:-/usr/local/bin/sing-box}"
  local TMP_DL=$(mktemp -d)
  local REL VER URL FILE

  REL=$(curl -s --connect-timeout 10 --max-time 20 "$GITHUB_API")
  VER=$(echo "$REL" | jq -r '.tag_name' 2>/dev/null || true)

  if [[ -z "$VER" || "$VER" = "null" ]]; then
    rm -rf "$TMP_DL"
    return 1
  fi

  URL=$(echo "$REL" | jq -r ".assets[].browser_download_url" | grep -i "linux" | grep -i "$ARCH" | grep -v -i "sha256" | grep -v -i "v3" | head -1 || true)

  if [[ -z "$URL" ]]; then
    rm -rf "$TMP_DL"
    return 1
  fi

  wget --timeout=30 -q -O "${TMP_DL}/sing-box.pkg" "$URL" || {
    rm -rf "$TMP_DL"
    return 1
  }

  if [[ "$URL" == *.tar.gz ]]; then
    tar -xf "${TMP_DL}/sing-box.pkg" -C "${TMP_DL}"
  elif [[ "$URL" == *.zip ]]; then
    unzip -q -o "${TMP_DL}/sing-box.pkg" -d "${TMP_DL}"
  else
    cp "${TMP_DL}/sing-box.pkg" "${TMP_DL}/sing-box"
  fi

  FILE=$(find "${TMP_DL}" -type f -name "sing-box" | head -1)
  if [[ -z "$FILE" ]]; then
    rm -rf "$TMP_DL"
    return 1
  fi

  cp "$FILE" "$DEST_BIN"
  chmod +x "$DEST_BIN"
  rm -rf "$TMP_DL"
  echo "$VER"
}

# ==================== 清理垃圾 ====================
cleanup_old() {
  rm -f /usr/local/bin/sing-box.bak
  rm -rf /tmp/sing-box.* /tmp/anytls-* 2>/dev/null || true
  apt-get clean >/dev/null 2>&1 || true
}

# ==================== 防火墙配置 ====================
setup_ufw() {
  local PORT="$1"
  print_info "配置防火墙 (UFW)..."
  systemctl unmask ufw >/dev/null 2>&1 || true
  systemctl enable --now ufw >/dev/null 2>&1 || true
  ufw --force reset >/dev/null 2>&1 || true
  ufw default deny incoming >/dev/null 2>&1 || true
  ufw default allow outgoing >/dev/null 2>&1 || true

  local SSH_PORT=22
  if [[ -f /etc/ssh/sshd_config ]]; then
    SSH_PORT=$(grep -Ei '^\s*Port\s+' /etc/ssh/sshd_config | head -1 | awk '{print $2}' | tr -d '\r\n' || true)
  fi
  if [[ -z "$SSH_PORT" ]] && [[ -d /etc/ssh/sshd_config.d ]]; then
    SSH_PORT=$(grep -Ei '^\s*Port\s+' /etc/ssh/sshd_config.d/*.conf 2>/dev/null | head -1 | awk '{print $2}' | tr -d '\r\n' || true)
  fi
  [[ "$SSH_PORT" =~ ^[0-9]+$ ]] || SSH_PORT=22

  ufw allow "${SSH_PORT}/tcp" comment 'SSH' >/dev/null 2>&1 || true
  ufw allow "${PORT}/tcp" comment 'AnyTLS TCP' >/dev/null 2>&1 || true
  ufw allow "${PORT}/udp" comment 'AnyTLS UDP' >/dev/null 2>&1 || true
  ufw --force enable >/dev/null 2>&1 || true
  ufw reload >/dev/null 2>&1 || true
  judge "UFW 防火墙配置"
}

# ==================== 定时任务 ====================
setup_cron() {
  print_info "设置定时自动更新（每周日 19:07 上海时间）..."
  cat > "$CRON_AUTO" <<'EOF'
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
TZ=Asia/Shanghai
7 19 * * 0 root /usr/local/bin/anytls -v >> /var/log/anytls-update.log 2>&1 && /usr/local/bin/anytls --cleanup
EOF
  chmod 644 "$CRON_AUTO"

  cat > "$CRON_CLEAN" <<'EOF'
7 7 * * 0 root /bin/bash -c 'apt-get clean && apt-get autoclean -y && apt-get autoremove -y && rm -rf /var/lib/apt/lists/* && journalctl --vacuum-time=5d --vacuum-size=30M && find /tmp /var/tmp -type f -mtime +7 -delete' >/dev/null 2>&1
EOF
  chmod 644 "$CRON_CLEAN"
  judge "定时任务配置"
}

# ==================== 导出节点信息 ====================
export_client_info() {
  local PORT="$1" PASS="$2" SNI="$3" NAME="$4"
  check_system_ip

  local FINGERPRINT_SHA256=$(openssl x509 -fingerprint -noout -sha256 -in "${CONFIG_DIR}/cert/cert.pem" | awk -F '=' '{print $NF}')
  local FINGERPRINT_BASE64=$(openssl x509 -in "${CONFIG_DIR}/cert/cert.pem" -pubkey -noout | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | openssl enc -base64)

  local URI_V4="" URI_V6=""
  [[ -n "$IPV4" ]] && URI_V4="anytls://${PASS}@${IPV4}:${PORT}?peer=${SNI}&udp=1&hpkp=${FINGERPRINT_SHA256}#${NAME// /%20}"
  [[ -n "$IPV6" ]] && URI_V6="anytls://${PASS}@[${IPV6}]:${PORT}?peer=${SNI}&udp=1&hpkp=${FINGERPRINT_SHA256}#${NAME// /%20}"

  {
    echo "=========== AnyTLS (sing-box) 配置参数 ==========="
    echo " 代理模式: AnyTLS (sing-box 内置 inbound)"
    echo " 服务器: ${MAIN_IP:-未知}"
    echo " IPv4: ${IPV4:-无}"
    echo " IPv6: ${IPV6:-无}"
    echo " 端口: ${PORT}"
    echo " 密码: ${PASS}"
    echo " SNI: ${SNI}"
    echo " sing-box 版本: $(get_local_version)"
    echo "=================================================="
    [[ -n "$URI_V4" ]] && echo -e "\n【IPv4 节点链接】\n${URI_V4}"
    [[ -n "$URI_V6" ]] && echo -e "\n【IPv6 节点链接】\n${URI_V6}"
    echo -e "\n【CA 证书路径】 ${CONFIG_DIR}/cert/ca.crt"
    echo -e "\n【客户端配置 - CA 信任链】"
    cat <<EOF
{
    "type": "anytls",
    "tag": "${NAME}",
    "server": "${MAIN_IP}",
    "server_port": ${PORT},
    "password": "${PASS}",
    "idle_session_check_interval": "30s",
    "idle_session_timeout": "30s",
    "min_idle_session": 5,
    "tls": {
        "enabled": true,
        "server_name": "${SNI}",
        "certificate": ["${CONFIG_DIR}/cert/ca.crt"],
        "utls": { "enabled": true, "fingerprint": "chrome" }
    }
}
EOF
    echo -e "\n【客户端配置 - HPKP 证书固定】"
    cat <<EOF
{
    "type": "anytls",
    "tag": "${NAME}",
    "server": "${MAIN_IP}",
    "server_port": ${PORT},
    "password": "${PASS}",
    "idle_session_check_interval": "30s",
    "idle_session_timeout": "30s",
    "min_idle_session": 5,
    "tls": {
        "enabled": true,
        "certificate_public_key_sha256": ["${FINGERPRINT_BASE64}"],
        "server_name": "${SNI}",
        "utls": { "enabled": true, "fingerprint": "chrome" }
    }
}
EOF
  } > "$LIST_FILE"
}

# ==================== 快捷命令配置 ====================
create_shortcut() {
  local PANEL="/usr/local/bin/anytls-panel.sh"
  local PANEL_BAK="${CONFIG_DIR}/anytls-panel.sh"
  local SRC=""

  mkdir -p "$CONFIG_DIR"

  # 1. 优先尝试定位当前脚本所在路径
  for candidate in "${BASH_SOURCE[0]:-}" "$0"; do
    if [[ -n "$candidate" && -f "$candidate" && -r "$candidate" ]]; then
      if grep -q "AnyTLS (sing-box) 一键管理脚本" "$candidate" 2>/dev/null; then
        SRC="$candidate"
        break
      fi
    fi
  done

  if [[ -n "$SRC" ]]; then
    cp -f "$SRC" "$PANEL"
    chmod +x "$PANEL"
    cp -f "$SRC" "$PANEL_BAK" 2>/dev/null || true
    print_ok "面板脚本已成功保存"
  elif [[ -n "${SCRIPT_URL:-}" ]]; then
    print_info "尝试从远程 URL 下载脚本保存面板..."
    if curl -sSL --connect-timeout 10 -o "$PANEL" "$SCRIPT_URL" 2>/dev/null || wget -q -O "$PANEL" "$SCRIPT_URL" 2>/dev/null; then
      chmod +x "$PANEL"
      cp -f "$PANEL" "$PANEL_BAK" 2>/dev/null || true
      print_ok "已从远程下载并保存面板脚本"
    fi
  fi

  # 2. 补全互备路径
  if [[ ! -s "$PANEL" && -s "$PANEL_BAK" ]]; then
    cp -f "$PANEL_BAK" "$PANEL"
    chmod +x "$PANEL"
  elif [[ -s "$PANEL" && ! -s "$PANEL_BAK" ]]; then
    cp -f "$PANEL" "$PANEL_BAK"
  fi

  if [[ ! -s "$PANEL" ]]; then
    print_warn "未能自动保留面板脚本文件。"
    print_warn "提示：通过管道 (curl | bash) 运行脚本时，建议先下载脚本文件到本地，例如："
    print_warn "      wget -O anytls.sh <脚本URL> && chmod +x anytls.sh && ./anytls.sh"
  fi

  # 3. 创建快捷指令 a
  cat > /usr/local/bin/a <<'EOF'
#!/bin/bash
for path in /usr/local/bin/anytls-panel.sh /etc/anytls/anytls-panel.sh; do
  if [[ -f "$path" && -s "$path" ]]; then
    exec bash "$path" "$@"
  fi
done
echo "未找到 AnyTLS 面板脚本，请把脚本保存到本地后再运行安装"
exit 1
EOF
  chmod +x /usr/local/bin/a

  # 4. 创建快捷指令 anytls
  cat > /usr/local/bin/anytls <<'EOF'
#!/bin/bash
PANEL="/usr/local/bin/anytls-panel.sh"
[[ -f "$PANEL" && -s "$PANEL" ]] || PANEL="/etc/anytls/anytls-panel.sh"

case "${1:-}" in
  -v|--upgrade)
    if [[ -f "$PANEL" && -s "$PANEL" ]]; then
      exec bash "$PANEL" --upgrade
    else
      echo "未找到面板脚本"
    fi
    ;;
  --cleanup)
    rm -f /usr/local/bin/sing-box.bak
    rm -rf /tmp/sing-box.* 2>/dev/null || true
    apt-get clean >/dev/null 2>&1 || true
    ;;
  *)
    if [[ -f "$PANEL" && -s "$PANEL" ]]; then
      exec bash "$PANEL" "$@"
    else
      echo "AnyTLS 快捷命令"
      echo "  anytls -v, --upgrade  升级 sing-box"
      echo "  anytls --cleanup      清理旧备份"
    fi
    ;;
esac
EOF
  chmod +x /usr/local/bin/anytls
}

# ==================== 核心功能：安装 ====================
install_anytls() {
  clear
  hr
  print_info "开始安装 AnyTLS (sing-box)"
  hr

  # 如果已安装，先停止服务并删除旧二进制
  if is_installed; then
    print_info "检测到已有安装，先停止服务并清理旧版本..."
    systemctl stop anytls >/dev/null 2>&1 || true
    systemctl disable anytls >/dev/null 2>&1 || true
    rm -f /usr/local/bin/sing-box /usr/local/bin/sing-box.bak
    sleep 1
    print_ok "旧版本已清理"
  fi

  # 依赖
  print_info "安装依赖..."
  if command -v apt-get >/dev/null 2>&1; then
    apt-get update -qq >/dev/null 2>&1 || true
    apt-get install -y -qq wget unzip curl ufw iproute2 cron jq tar openssl >/dev/null 2>&1 || true
  elif command -v dnf >/dev/null 2>&1; then
    dnf update -y >/dev/null 2>&1 || true
    dnf install -y wget unzip curl firewalld cronie jq tar openssl >/dev/null 2>&1 || true
  elif command -v yum >/dev/null 2>&1; then
    yum update -y >/dev/null 2>&1 || true
    yum install -y wget unzip curl firewalld cronie jq tar openssl >/dev/null 2>&1 || true
  fi
  judge "依赖安装"

  # 网络优化 (开启 IPv4 优先、BBR 及 TCP Fast Open)
  print_info "优化网络配置..."
  grep -q "precedence ::ffff:0:0/96 100" /etc/gai.conf 2>/dev/null || echo "precedence ::ffff:0:0/96 100" >> /etc/gai.conf
  systemctl disable systemd-resolved --now >/dev/null 2>&1 || true
  systemctl mask systemd-resolved >/dev/null 2>&1 || true
  chattr -i /etc/resolv.conf >/dev/null 2>&1 || true
  cat > /etc/resolv.conf <<EOF
nameserver 1.1.1.1
nameserver 8.8.8.8
nameserver 2606:4700:4700::1111
nameserver 2001:4860:4860::8888
EOF
  chattr +i /etc/resolv.conf >/dev/null 2>&1 || true

  cat > /etc/sysctl.d/99-bbr.conf <<'EOF'
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
net.ipv4.tcp_fastopen=3
EOF
  sysctl -w net.ipv4.tcp_fastopen=3 >/dev/null 2>&1 || true
  sysctl --system >/dev/null 2>&1 || true

  # 架构
  ARCH=$(get_arch)
  print_info "检测到系统架构: ${BGreen}${ARCH}${Font}"

  # 交互输入
  check_system_ip
  [[ -z "$MAIN_IP" ]] && { print_err "无法获取服务器 IP"; exit 1; }

  echo ""
  echo -e "当前服务器 IP: ${BGreen}${MAIN_IP}${Font}"
  echo -e "以下配置直接回车将使用默认值"
  echo ""

  local input_port input_pass input_name input_sni
  read -rp "请输入 AnyTLS 端口 [默认: 26216]: " input_port
  local PORT=${input_port:-26216}
  while ! valid_port "$PORT" || is_port_used "$PORT"; do
    print_warn "端口无效或已被占用"
    read -rp "请输入 AnyTLS 端口 [默认: 26216]: " input_port
    PORT=${input_port:-26216}
  done

  local DEF_PASS=$(gen_password)
  read -rp "请输入 AnyTLS 密码 [默认: ${DEF_PASS}]: " input_pass
  local PASS=${input_pass:-$DEF_PASS}

  local DEF_NAME=$(hostname 2>/dev/null || echo "AnyTLS")
  read -rp "请输入节点名称 [默认: ${DEF_NAME}]: " input_name
  local NAME=${input_name:-$DEF_NAME}

  read -rp "请输入 SNI 域名 [默认: addons.mozilla.org]: " input_sni
  local SNI=${input_sni:-addons.mozilla.org}

  # 证书
  print_info "生成自签 CA 及服务器证书..."
  ssl_certificate "$SNI"
  judge "证书生成"

  # 下载 sing-box
  print_info "获取 sing-box 最新版本..."
  local VER=$(download_singbox /usr/local/bin)
  [[ -z "$VER" ]] && { print_err "下载 sing-box 失败"; exit 1; }
  print_ok "sing-box 已安装: ${VER}"

  # 配置文件
  mkdir -p "$CONFIG_DIR"
  cat > "$CONFIG_JSON" <<EOF
{
    "log": { "level": "warn" },
    "inbounds": [
        {
            "type": "anytls",
            "tag": "anytls-in",
            "listen": "::",
            "listen_port": ${PORT},
            "users": [{ "password": "${PASS}" }],
            "padding_scheme": [
                "stop=3",
                "0=30-50",
                "1=100-400",
                "2=500-900"
            ],
            "tls": {
                "enabled": true,
                "certificate_path": "${CONFIG_DIR}/cert/cert.pem",
                "key_path": "${CONFIG_DIR}/cert/private.key"
            }
        }
    ],
    "outbounds": [{ "type": "direct", "tag": "direct" }]
}
EOF

  # systemd
  cat > "$ANYTLS_SERVICE_FILE" <<EOF
[Unit]
Description=AnyTLS Server (sing-box)
After=network.target

[Service]
Type=simple
LimitNOFILE=65535
ExecStart=/usr/local/bin/sing-box run -c ${CONFIG_JSON}
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
EOF

  systemctl daemon-reload
  systemctl enable anytls >/dev/null 2>&1 || true
  systemctl restart anytls >/dev/null 2>&1 || true
  sleep 2

  if ! systemctl is-active --quiet anytls; then
    print_err "AnyTLS 启动失败"
    journalctl -u anytls -n 20 --no-pager
    exit 1
  fi
  judge "服务启动"

  # 防火墙
  setup_ufw "$PORT"

  # 定时任务
  setup_cron

  # 快捷命令
  create_shortcut

  # 导出信息
  export_client_info "$PORT" "$PASS" "$SNI" "$NAME"

  # 完成
  echo ""
  hr
  print_ok "AnyTLS 部署完成"
  hr
  echo -e " sing-box 版本: ${BGreen}$(get_local_version)${Font}"
  echo -e " 监听端口: ${BGreen}${PORT}${Font}"
  echo -e " 节点名称: ${BGreen}${NAME}${Font}"
  echo ""
  cat "$LIST_FILE"
  hr
  
  pause
}

# ==================== 核心功能：更新 ====================
update_anytls() {
  clear
  hr
  print_info "检查 sing-box / AnyTLS 更新"
  hr

  if ! is_installed; then
    print_err "AnyTLS 未安装，无法更新"
    pause
    return
  fi

  local LOCAL_VER=$(get_local_version)
  local REMOTE_VER=$(get_remote_version)

  if [[ -z "$REMOTE_VER" ]]; then
    print_err "获取在线版本失败，请检查网络"
    pause
    return
  fi

  echo -e " 本地版本: ${LOCAL_VER}"
  echo -e " 远程版本: ${REMOTE_VER}"

  if [[ "$LOCAL_VER" = "$REMOTE_VER" ]]; then
    print_ok "当前已是最新版本"
    pause
    return
  fi

  local ans
  read -rp "是否升级到 ${REMOTE_VER}? [y/N]: " ans
  [[ ! "${ans:-N}" =~ ^[Yy]$ ]] && { print_info "已取消"; pause; return; }

  print_info "备份旧版本..."
  cp -f /usr/local/bin/sing-box /usr/local/bin/sing-box.bak

  print_info "下载新版本..."
  local DOWNLOADED=$(download_singbox /usr/local/bin)
  if [[ -z "$DOWNLOADED" ]]; then
    print_err "下载失败，恢复旧版本..."
    cp -f /usr/local/bin/sing-box.bak /usr/local/bin/sing-box
    pause
    return
  fi

  print_info "检查配置兼容性..."
  if [[ -s "$CONFIG_JSON" ]]; then
    if ! /usr/local/bin/sing-box check -c "$CONFIG_JSON" >/dev/null 2>&1; then
      print_err "新版本与当前配置不兼容，恢复旧版本..."
      cp -f /usr/local/bin/sing-box.bak /usr/local/bin/sing-box
      pause
      return
    fi
  fi

  print_info "重启服务..."
  systemctl restart anytls >/dev/null 2>&1 || true
  sleep 2

  if systemctl is-active --quiet anytls; then
    print_ok "升级成功！当前版本: $(get_local_version)"
    rm -f /usr/local/bin/sing-box.bak
    cleanup_old
    [[ -f "$LIST_FILE" ]] && sed -i "s/sing-box 版本:.*/sing-box 版本: $(get_local_version)/" "$LIST_FILE"
  else
    print_err "新版本启动失败，恢复旧版本..."
    cp -f /usr/local/bin/sing-box.bak /usr/local/bin/sing-box
    systemctl restart anytls >/dev/null 2>&1 || true
    sleep 2
    if systemctl is-active --quiet anytls; then
      print_ok "已恢复旧版本，服务正常运行"
    else
      print_err "恢复后服务仍异常，请检查: journalctl -u anytls -n 30"
    fi
  fi
  pause
}

