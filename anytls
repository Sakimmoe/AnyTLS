#!/bin/bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

# 接收参数：域名、端口、密码
DOMAIN=${1:-}
ANYTLS_PORT=${2:-443}
ANYTLS_PASSWORD=${3:-kokonoeyukari}
GITHUB_API="https://api.github.com/repos/anytls/anytls-go/releases/latest"

echo "=========================================="
echo " AnyTLS 部署脚本 (CA证书)"
echo "=========================================="

if [ "$EUID" -ne 0 ]; then
    echo "Error: 请使用 root 用户运行"
    exit 1
fi

if [ -z "$DOMAIN" ]; then
    echo "Error: 缺少域名参数！"
    echo "用法: bash $0 <你的域名> [端口] [密码]"
    echo "示例: bash $0 anytls.example.com 443 mypassword123"
    exit 1
fi

echo "正在安装系统依赖..."
apt-get update -qq >/dev/null 2>&1 || true
apt-get install -y -qq wget unzip curl ufw iproute2 cron jq tar socat >/dev/null 2>&1 || true

echo "正在放行 80 端口用于申请证书..."
ufw allow 80/tcp >/dev/null 2>&1 || true

echo "正在安装 acme.sh 并申请 CA 证书..."
curl https://get.acme.sh | sh -s email=admin@${DOMAIN} >/dev/null 2>&1 || true
~/.acme.sh/acme.sh --set-default-ca --server letsencrypt >/dev/null 2>&1 || true

# 申请证书 (使用 standalone 模式)
~/.acme.sh/acme.sh --issue -d ${DOMAIN} --standalone

# 安装证书到指定目录
mkdir -p /etc/anytls
~/.acme.sh/acme.sh --installcert -d ${DOMAIN} \
    --key-file /etc/anytls/server.key \
    --fullchain-file /etc/anytls/server.crt

echo "获取 AnyTLS 最新版本..."
case "$(uname -m)" in
    x86_64|amd64) ARCH="amd64" ;;
    aarch64|arm64) ARCH="arm64" ;;
    *) echo "不支持的架构"; exit 1 ;;
esac

RELEASE_INFO=$(curl -s --connect-timeout 10 ${GITHUB_API})
ASSET_URL=$(echo "$RELEASE_INFO" | jq -r ".assets[].browser_download_url" | grep -i "linux" | grep -i "${ARCH}" | grep -v -i "sha256" | head -1 || true)

TMP=$(mktemp -d)
wget -q -O ${TMP}/anytls.pkg "$ASSET_URL"

rm -f /usr/local/bin/anytls-server
if [[ "$ASSET_URL" == *.tar.gz ]]; then
    tar -xf ${TMP}/anytls.pkg -C ${TMP}
elif [[ "$ASSET_URL" == *.zip ]]; then
    unzip -q -o ${TMP}/anytls.pkg -d ${TMP}
else
    cp ${TMP}/anytls.pkg ${TMP}/anytls-server
fi

FILE=$(find ${TMP} -type f -name "anytls-server" | head -1)
cp "$FILE" /usr/local/bin/anytls-server
chmod +x /usr/local/bin/anytls-server
rm -rf ${TMP}

echo "配置 systemd 服务..."
cat > /etc/systemd/system/anytls.service << EOF
[Unit]
Description=AnyTLS Server Service (Secure)
After=network.target

[Service]
Type=simple
LimitNOFILE=65535
ExecStart=/usr/local/bin/anytls-server -l 0.0.0.0:${ANYTLS_PORT} -p ${ANYTLS_PASSWORD} -cert /etc/anytls/server.crt -key /etc/anytls/server.key
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable anytls >/dev/null 2>&1 || true
systemctl restart anytls >/dev/null 2>&1 || true
sleep 2

echo "配置防火墙..."
ufw allow ${ANYTLS_PORT}/tcp comment 'AnyTLS TCP' >/dev/null 2>&1 || true
ufw allow ${ANYTLS_PORT}/udp comment 'AnyTLS UDP' >/dev/null 2>&1 || true
ufw reload >/dev/null 2>&1 || true

echo -e "\n=============================="
echo " AnyTLS CA证书安全部署完成"
echo "=============================="
echo " Domain   : $DOMAIN"
echo " Port     : $ANYTLS_PORT"
echo " Password : $ANYTLS_PASSWORD"
echo " Cert Path: /etc/anytls/server.crt"
echo " Key Path : /etc/anytls/server.key"
echo "=============================="
echo "安全的客户端 URI 配置："
echo "anytls://${ANYTLS_PASSWORD}@${DOMAIN}:${ANYTLS_PORT}"
echo "=============================="
