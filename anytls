change_port() {
  clear
  hr
  print_info "更改 AnyTLS 端口"
  hr

  if ! is_installed; then
    print_err "AnyTLS 未安装"
    pause
    return
  fi

  local CUR_PORT=$(jq -r '.inbounds[0].listen_port' "$CONFIG_JSON" 2>/dev/null || echo "26216")
  local NEW_PORT=$(read_port_interactive "" "$CUR_PORT")

  [[ "$NEW_PORT" = "$CUR_PORT" ]] && { print_ok "端口未变更"; pause; return; }

  jq --argjson port "$NEW_PORT" '.inbounds[0].listen_port = $port' "$CONFIG_JSON" > "${CONFIG_JSON}.tmp" && mv "${CONFIG_JSON}.tmp" "$CONFIG_JSON"
  judge "配置更新"

  setup_ufw "$NEW_PORT"

  systemctl restart anytls >/dev/null 2>&1 || true
  sleep 1
  if is_active; then
    print_ok "端口已更新为: ${NEW_PORT}"
    local PASS=$(jq -r '.inbounds[0].users[0].password' "$CONFIG_JSON")
    local SNI=$(get_current_sni)
    local NAME=$(cat "$NAME_FILE" 2>/dev/null || jq -r '.inbounds[0].tag' "$CONFIG_JSON" 2>/dev/null || echo "AnyTLS")
    export_client_info "$NEW_PORT" "$PASS" "${SNI:-addons.mozilla.org}" "$NAME"
  else
    print_err "服务重启失败"
  fi
  pause
}

# ==================== 更改密码 ====================
change_password() {
  clear
  hr
  print_info "更改 AnyTLS 密码"
  hr

  if ! is_installed; then
    print_err "AnyTLS 未安装"
    pause
    return
  fi

  local CUR_PASS=$(jq -r '.inbounds[0].users[0].password' "$CONFIG_JSON" 2>/dev/null || echo "")
  local DEF_PASS=$(gen_password)
  local input
  read -rp "请输入新密码 [默认: ${DEF_PASS}]: " input
  local NEW_PASS=${input:-$DEF_PASS}

  [[ "$NEW_PASS" = "$CUR_PASS" ]] && { print_ok "密码未变更"; pause; return; }

  jq --arg pass "$NEW_PASS" '.inbounds[0].users[0].password = $pass' "$CONFIG_JSON" > "${CONFIG_JSON}.tmp" && mv "${CONFIG_JSON}.tmp" "$CONFIG_JSON"
  judge "密码更新"

  systemctl restart anytls >/dev/null 2>&1 || true
  sleep 1
  if is_active; then
    print_ok "密码已更新"
    local PORT=$(jq -r '.inbounds[0].listen_port' "$CONFIG_JSON")
    local SNI=$(get_current_sni)
    local NAME=$(cat "$NAME_FILE" 2>/dev/null || jq -r '.inbounds[0].tag' "$CONFIG_JSON" 2>/dev/null || echo "AnyTLS")
    export_client_info "$PORT" "$NEW_PASS" "${SNI:-addons.mozilla.org}" "$NAME"
  else
    print_err "服务重启失败"
  fi
  pause
}

# ==================== 更改 SNI ====================
change_sni() {
  clear
  hr
  print_info "更改 SNI / 证书域名"
  hr

  if ! is_installed; then
    print_err "AnyTLS 未安装"
    pause
    return
  fi

  local CUR_SNI=$(get_current_sni)
  local input
  read -rp "请输入新域名 [当前: ${CUR_SNI:-addons.mozilla.org}]: " input
  local NEW_SNI=${input:-${CUR_SNI:-addons.mozilla.org}}

  [[ "$NEW_SNI" = "$CUR_SNI" ]] && { print_ok "SNI 未变更"; pause; return; }

  if [[ "$(get_cert_mode)" == "acme" ]]; then
    print_info "更新 ACME 证书域名..."
    if jq -e '.inbounds[0].tls.certificate_provider.domain[0]' "$CONFIG_JSON" >/dev/null 2>&1; then
      jq --arg d "$NEW_SNI" '.inbounds[0].tls.certificate_provider.domain = [$d]' "$CONFIG_JSON" > "${CONFIG_JSON}.tmp" && mv "${CONFIG_JSON}.tmp" "$CONFIG_JSON"
    else
      jq --arg d "$NEW_SNI" '.inbounds[0].tls.acme.domain = [$d]' "$CONFIG_JSON" > "${CONFIG_JSON}.tmp" && mv "${CONFIG_JSON}.tmp" "$CONFIG_JSON"
    fi
    judge "证书域名更新"
  else
    print_info "重新生成自签证书..."
    ssl_certificate "$NEW_SNI"
    judge "证书生成"
  fi

  systemctl restart anytls >/dev/null 2>&1 || true
  sleep 1
  if is_active; then
    print_ok "SNI 已更新为: ${NEW_SNI}"
    local PORT=$(jq -r '.inbounds[0].listen_port' "$CONFIG_JSON")
    local PASS=$(jq -r '.inbounds[0].users[0].password' "$CONFIG_JSON")
    local NAME=$(cat "$NAME_FILE" 2>/dev/null || jq -r '.inbounds[0].tag' "$CONFIG_JSON" 2>/dev/null || echo "AnyTLS")
    export_client_info "$PORT" "$PASS" "$NEW_SNI" "$NAME"
  else
    print_err "服务重启失败"
  fi
  pause
}

# ==================== 重启 / 状态 ====================
restart_service() {
  clear
  hr
  print_info "重启 AnyTLS 服务..."
  systemctl restart anytls >/dev/null 2>&1 || true
  sleep 1
  if is_active; then
    print_ok "服务已重启"
  else
    print_err "服务重启失败"
    journalctl -u anytls -n 20 --no-pager
  fi
  pause
}

status_service() {
  clear
  systemctl status anytls --no-pager
  pause
}

# ==================== 卸载 ====================
uninstall_anytls() {
  clear
  hr
  if ! is_installed; then
    print_err "AnyTLS 未安装"
    pause
    return
  fi

  local ans
  read -rp "确认卸载并删除所有配置？(y/N): " ans
  [[ ! "${ans:-N}" =~ ^[Yy]$ ]] && { print_info "已取消"; pause; return; }

  print_info "停止服务..."
  systemctl stop anytls >/dev/null 2>&1 || true
  systemctl disable anytls >/dev/null 2>&1 || true
  rm -f "$ANYTLS_SERVICE_FILE"
  systemctl daemon-reload >/dev/null 2>&1 || true

  print_info "清理文件..."
  rm -f /usr/local/bin/sing-box /usr/local/bin/sing-box.bak
  rm -f /usr/local/bin/anytls
  rm -f /usr/local/bin/a
  rm -f /usr/local/bin/anytls-panel.sh
  rm -f "${CONFIG_DIR}/anytls-panel.sh"
  rm -f "$CRON_CLEAN"
  rm -f /usr/local/bin/anytls-cleanup.sh
  rm -f "$NAME_FILE"
  rm -rf "$CONFIG_DIR"

  print_ok "AnyTLS 已彻底卸载"
  pause
}

# ==================== 主菜单 ====================
main() {
  while true; do
    clear
    hr
    echo -e " ${Bold}AnyTLS (sing-box) 一键管理脚本${Font}"
    echo -e " 基于 sing-box 内置 anytls 协议 | 自签 CA + 证书固定"
    echo -e " 当前脚本版本: ${Magenta}${SHELL_VERSION}${Font}"
    echo -e " 安装状态：$(install_status_text)"
    echo -e " sing-box 版本: ${Cyan}$(get_local_version)${Font}"
    hr
    echo -e "${Cyan} 1. 安装 / 重装 AnyTLS${Font}"
    echo -e "${Cyan} 2. 更新 sing-box / AnyTLS${Font}"
    echo -e "${Cyan} 3. 查看节点配置${Font}"
    echo -e "${Cyan} 4. 更改端口${Font}"
    echo -e "${Cyan} 5. 更改密码${Font}"
    echo -e "${Cyan} 6. 更改 SNI / 证书域名${Font}"
    echo -e "${Cyan} 7. 重启服务${Font}"
    echo -e "${Cyan} 8. 查看运行状态${Font}"
    echo -e "${Cyan} 9. 卸载 AnyTLS${Font}"
    echo -e "${Cyan} 10. 重新应用网络优化 / 调整 Swap${Font}"
    echo -e "${Cyan} 0. 退出${Font}"
    hr
    read -rp "请输入数字 [0-10]: " choice

    case "$choice" in
      1) install_anytls ;;
      2) update_anytls ;;
      3) view_config ;;
      4) change_port ;;
      5) change_password ;;
      6) change_sni ;;
      7) restart_service ;;
      8) status_service ;;
      9) uninstall_anytls ;;
      10) apply_network_optimization; setup_swap ;;
      0) exit 0 ;;
      *) print_warn "无效选项"; sleep 1 ;;
    esac
  done
}

