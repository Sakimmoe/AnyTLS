# ==================== 更改端口 ====================
change_port() {
  clear
  hr
  print_info "更改 AnyTLS 端口"
  hr

  if ! is_installed; then
    print_err "AnyTLS 未安装"
    pause
    return
  fi

  local CUR_PORT=$(jq -r '.inbounds[0].listen_port' "$CONFIG_JSON" 2>/dev/null || echo "26216")
  local NEW_PORT=$(read_port_interactive "" "$CUR_PORT")

  [[ "$NEW_PORT" = "$CUR_PORT" ]] && { print_ok "端口未变更"; pause; return; }

  jq --argjson port "$NEW_PORT" '.inbounds[0].listen_port = $port' "$CONFIG_JSON" > "${CONFIG_JSON}.tmp" && mv "${CONFIG_JSON}.tmp" "$CONFIG_JSON"
  judge "配置更新"

  setup_ufw "$NEW_PORT"

  systemctl restart anytls >/dev/null 2>&1 || true
  sleep 1
  if is_active; then
    print_ok "端口已更新为: ${NEW_PORT}"
    local PASS=$(jq -r '.inbounds[0].users[0].password' "$CONFIG_JSON")
    local SNI=$(openssl x509 -noout -ext subjectAltName -in "${CONFIG_DIR}/cert/cert.pem" 2>/dev/null | awk -F 'DNS:' '/DNS:/{gsub(/,.*/,"",$2); print $2}')
    local NAME=$(jq -r '.inbounds[0].tag' "$CONFIG_JSON" 2>/dev/null || echo "AnyTLS")
    export_client_info "$NEW_PORT" "$PASS" "${SNI:-addons.mozilla.org}" "$NAME"
  else
    print_err "服务重启失败"
  fi
  pause
}

# ==================== 更改密码 ====================
change_password() {
  clear
  hr
  print_info "更改 AnyTLS 密码"
  hr

  if ! is_installed; then
    print_err "AnyTLS 未安装"
    pause
    return
  fi

  local CUR_PASS=$(jq -r '.inbounds[0].users[0].password' "$CONFIG_JSON" 2>/dev/null || echo "")
  local DEF_PASS=$(gen_password)
  local input
  read -rp "请输入新密码 [默认: ${DEF_PASS}]: " input
  local NEW_PASS=${input:-$DEF_PASS}

  [[ "$NEW_PASS" = "$CUR_PASS" ]] && { print_ok "密码未变更"; pause; return; }

  jq --arg pass "$NEW_PASS" '.inbounds[0].users[0].password = $pass' "$CONFIG_JSON" > "${CONFIG_JSON}.tmp" && mv "${CONFIG_JSON}.tmp" "$CONFIG_JSON"
  judge "密码更新"

  systemctl restart anytls >/dev/null 2>&1 || true
  sleep 1
  if is_active; then
    print_ok "密码已更新"
    local PORT=$(jq -r '.inbounds[0].listen_port' "$CONFIG_JSON")
    local SNI=$(openssl x509 -noout -ext subjectAltName -in "${CONFIG_DIR}/cert/cert.pem" 2>/dev/null | awk -F 'DNS:' '/DNS:/{gsub(/,.*/,"",$2); print $2}')
    local NAME=$(jq -r '.inbounds[0].tag' "$CONFIG_JSON" 2>/dev/null || echo "AnyTLS")
    export_client_info "$PORT" "$NEW_PASS" "${SNI:-addons.mozilla.org}" "$NAME"
  else
    print_err "服务重启失败"
  fi
  pause
}

# ==================== 更改 SNI ====================
change_sni() {
  clear
  hr
  print_info "更改 SNI 并重新生成证书"
  hr

  if ! is_installed; then
    print_err "AnyTLS 未安装"
    pause
    return
  fi

  local CUR_SNI=$(openssl x509 -noout -ext subjectAltName -in "${CONFIG_DIR}/cert/cert.pem" 2>/dev/null | awk -F 'DNS:' '/DNS:/{gsub(/,.*/,"",$2); print $2}')
  local input
  read -rp "请输入新 SNI [当前: ${CUR_SNI:-addons.mozilla.org}]: " input
  local NEW_SNI=${input:-${CUR_SNI:-addons.mozilla.org}}

  [[ "$NEW_SNI" = "$CUR_SNI" ]] && { print_ok "SNI 未变更"; pause; return; }

  print_info "重新生成证书..."
  ssl_certificate "$NEW_SNI"
  judge "证书生成"

  systemctl restart anytls >/dev/null 2>&1 || true
  sleep 1
  if is_active; then
    print_ok "SNI 已更新为: ${NEW_SNI}"
    local PORT=$(jq -r '.inbounds[0].listen_port' "$CONFIG_JSON")
    local PASS=$(jq -r '.inbounds[0].users[0].password' "$CONFIG_JSON")
    local NAME=$(jq -r '.inbounds[0].tag' "$CONFIG_JSON" 2>/dev/null || echo "AnyTLS")
    export_client_info "$PORT" "$PASS" "$NEW_SNI" "$NAME"
  else
    print_err "服务重启失败"
  fi
  pause
}

# ==================== 重启 / 状态 ====================
restart_service() {
  clear
  hr
  print_info "重启 AnyTLS 服务..."
  systemctl restart anytls >/dev/null 2>&1 || true
  sleep 1
  if is_active; then
    print_ok "服务已重启"
  else
    print_err "服务重启失败"
    journalctl -u anytls -n 20 --no-pager
  fi
  pause
}

status_service() {
  clear
  systemctl status anytls --no-pager
  pause
}

# ==================== 卸载 ====================
uninstall_anytls() {
  clear
  hr
  if ! is_installed; then
    print_err "AnyTLS 未安装"
    pause
    return
  fi

  local ans
  read -rp "确认卸载并删除所有配置？(y/N): " ans
  [[ ! "${ans:-N}" =~ ^[Yy]$ ]] && { print_info "已取消"; pause; return; }

  print_info "停止服务..."
  systemctl stop anytls >/dev/null 2>&1 || true
  systemctl disable anytls >/dev/null 2>&1 || true
  rm -f "$ANYTLS_SERVICE_FILE"
  systemctl daemon-reload >/dev/null 2>&1 || true

  print_info "清理文件..."
  rm -f /usr/local/bin/sing-box /usr/local/bin/sing-box.bak
  rm -f /usr/local/bin/anytls
  rm -f /usr/local/bin/a
  rm -f /usr/local/bin/anytls-panel.sh
  rm -f "${CONFIG_DIR}/anytls-panel.sh"
  rm -f "$CRON_AUTO" "$CRON_CLEAN"
  rm -rf "$CONFIG_DIR"

  print_ok "AnyTLS 已彻底卸载"
  pause
}

