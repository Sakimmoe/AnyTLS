#!/usr/bin/env bash
# AnyTLS (sing-box) 一键管理脚本：安装/更新/查看/更改端口/更改密码/更改SNI/卸载
# 基于 sing-box 内置 anytls inbound，自签 CA + 证书固定
# 智能双栈：IPv6 入站 + IPv4 出站解锁 / 单栈自适应 / 兼容 sing-box 1.12+
# 兼容 Debian/Ubuntu/CentOS，支持 amd64 / arm64

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

# ==================== 配置路径 ====================
CONFIG_DIR="/etc/anytls"
WORK_DIR="$CONFIG_DIR"
ANYTLS_SERVICE_NAME="anytls.service"
ANYTLS_SERVICE_FILE="/etc/systemd/system/${ANYTLS_SERVICE_NAME}"
CONFIG_JSON="${CONFIG_DIR}/config.json"
LIST_FILE="${CONFIG_DIR}/list"
CRON_CLEAN="/etc/cron.d/anytls-cleanup"
STACK_FILE="${CONFIG_DIR}/.stack"
NAME_FILE="${CONFIG_DIR}/.name"
CERT_MODE_FILE="${CONFIG_DIR}/.cert_mode"
NET_NOFILE_LIMIT=1048576
GITHUB_API="https://api.github.com/repos/SagerNet/sing-box/releases/latest"
TZ_DEFAULT="Asia/Shanghai"
SHELL_VERSION="1.3.4"
# 可选：如果将本脚本托管在 GitHub/Gist 等位置，在此填入 Raw 链接，在线一键安装时也能自动下载面板
SCRIPT_URL="https://raw.githubusercontent.com/Sakimmoe/AnyTLS/main/anytls"

# ==================== 颜色配置 ====================
Font="\033[0m"
Black="\033[30m"
Red="\033[31m"
Green="\033[32m"
Yellow="\033[33m"
Blue="\033[34m"
Magenta="\033[35m"
Cyan="\033[36m"
White="\033[37m"
BRed="\033[91m"
BGreen="\033[92m"
BYellow="\033[93m"
BCyan="\033[96m"
Bold="\033[1m"

OK="${Green}[OK]${Font}"
ERROR="${Red}[ERROR]${Font}"
WARN="${Yellow}[WARN]${Font}"
INFO="${Cyan}[INFO]${Font}"

print_ok()  { echo -e "${OK}${Blue} $1 ${Font}"; }
print_info(){ echo -e "${INFO}${Cyan} $1 ${Font}"; }
print_warn(){ echo -e "${WARN}${Yellow} $1 ${Font}"; }
print_err() { echo -e "${ERROR} ${BRed}$1${Font}"; }

judge() {
  if [[ $? -eq 0 ]]; then
    print_ok "$1 完成"
    sleep 0.5
  else
    print_err "$1 失败"
    exit 1
  fi
}

hr() { printf '%*s\n' 50 '' | tr ' ' '='; }

pause() { read -rp "按回车返回菜单..." _; }

ensure_root() {
  if [[ $EUID -ne 0 ]]; then
    clear
    print_err "必须使用 root 运行本脚本!"
    exit 1
  fi
}

# ==================== 状态检测 ====================
binary_exists() { [[ -x /usr/local/bin/sing-box ]]; }
service_exists() { [[ -f "$ANYTLS_SERVICE_FILE" ]]; }
is_installed()   { binary_exists || service_exists; }
is_active()      { systemctl is-active "$ANYTLS_SERVICE_NAME" >/dev/null 2>&1; }

get_local_version() {
  if binary_exists; then
    /usr/local/bin/sing-box version 2>/dev/null | awk '/version/{print $NF}' || echo "unknown"
  else
    echo "未安装"
  fi
}

get_remote_version() {
  curl -s --connect-timeout 10 --max-time 20 "$GITHUB_API" | jq -r '.tag_name' 2>/dev/null | sed 's/^v//' || echo ""
}

install_status_text() {
  local stack_info=""
  if [[ -f "$STACK_FILE" ]]; then
    local stack=$(cat "$STACK_FILE" 2>/dev/null || echo "")
    case "$stack" in
      dual)   stack_info=" | ${Cyan}双栈(ipv6入+ipv4出解锁)${Font}" ;;
      v4only) stack_info=" | ${Cyan}仅IPv4${Font}" ;;
      v6only) stack_info=" | ${Cyan}仅IPv6${Font}" ;;
    esac
  fi

  if is_installed; then
    if is_active; then
      echo -e "${BGreen}已安装（运行中）${Font}${stack_info}"
    else
      if systemctl is-failed "$ANYTLS_SERVICE_NAME" >/dev/null 2>&1; then
        echo -e "${BYellow}已安装（上次启动失败）${Font}${stack_info}"
      else
        echo -e "${BYellow}已安装（已停止）${Font}${stack_info}"
      fi
    fi
  else
    echo -e "${BRed}未安装${Font}"
  fi
}

# ==================== 工具函数 ====================
random_port() { shuf -i 2000-65000 -n 1; }
gen_password(){ cat /proc/sys/kernel/random/uuid; }

valid_port() {
  local p="${1:-}"
  [[ "$p" =~ ^[0-9]+$ ]] && (( p >= 1 && p <= 65535 ))
}

is_port_used() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -tuln | awk '{print $5}' | grep -Eq "[:.]${port}([[:space:]]|$)"
  elif command -v lsof >/dev/null 2>&1; then
    lsof -i :"$port" -sTCP:LISTEN >/dev/null 2>&1
  else
    return 1
  fi
}

read_port_interactive() {
  local input current="${2:-}"
  while true; do
    if [[ -n "$current" ]]; then
      read -rp "回车保持当前端口 [${current}]，或输入新端口(1-65535): " input
      [[ -z "$input" ]] && { echo "$current"; return; }
    else
      read -t 15 -rp "回车或等待15秒为随机端口，或输入端口(1-65535): " input || true
      [[ -z "$input" ]] && input=$(random_port)
    fi

    if ! valid_port "$input"; then
      print_warn "端口不合法：$input"
      continue
    fi
    if is_port_used "$input"; then
      print_warn "端口 $input 已被占用"
      continue
    fi
    echo "$input"
    break
  done
}

get_ip() {
  local ip4 ip6
  ip4=$(curl -4 -s --max-time 5 https://api.ipify.org 2>/dev/null || true)
  if [[ -n "$ip4" ]]; then
    echo "$ip4"
    return
  fi
  ip6=$(curl -6 -s --connect-timeout 3 https://api64.ipify.org 2>/dev/null || true)
  if [[ -n "$ip6" ]]; then
    echo "$ip6"
    return
  fi
  echo "未知"
}

check_system_ip() {
  IPV4=$(curl -4 -s --max-time 5 https://api.ipify.org 2>/dev/null || echo "")
  IPV6=$(curl -6 -s --connect-timeout 3 https://api64.ipify.org 2>/dev/null || echo "")
  MAIN_IP=$([ -n "$IPV4" ] && echo "$IPV4" || echo "$IPV6")

  if [[ -n "$IPV4" && -n "$IPV6" ]]; then
    IP_STACK="dual"
  elif [[ -n "$IPV4" ]]; then
    IP_STACK="v4only"
  elif [[ -n "$IPV6" ]]; then
    IP_STACK="v6only"
  else
    IP_STACK="unknown"
  fi
}

get_arch() {
  case "$(uname -m)" in
    x86_64|amd64) echo "amd64" ;;
    aarch64|arm64) echo "arm64" ;;
    *) print_err "不支持的架构: $(uname -m)"; exit 1 ;;
  esac
}

# ==================== 证书模式 ====================
get_cert_mode() {
  cat "$CERT_MODE_FILE" 2>/dev/null || echo "selfsigned"
}

get_current_sni() {
  if [[ "$(get_cert_mode)" == "acme" ]]; then
    jq -r '.inbounds[0].tls.certificate_provider.domain[0] // .inbounds[0].tls.acme.domain[0] // empty' "$CONFIG_JSON" 2>/dev/null
  else
    openssl x509 -noout -subject -in "${CONFIG_DIR}/cert/cert.pem" 2>/dev/null | awk -F 'CN *= *' '/subject=/{print $2}'
  fi
}

build_tls_json() {
  local CORE_MINOR=$(echo "$VER" | cut -d. -f2)
  if [[ "$CERT_MODE" == "acme" ]]; then
    if [[ "${CORE_MINOR:-0}" -ge 14 ]]; then
      TLS_JSON="\"tls\": { \"enabled\": true, \"certificate_provider\": { \"type\": \"acme\", \"domain\": [\"${TLS_DOMAIN}\"], \"data_directory\": \"${CONFIG_DIR}/certmagic\" } }"
    else
      TLS_JSON="\"tls\": { \"enabled\": true, \"acme\": { \"domain\": [\"${TLS_DOMAIN}\"], \"data_directory\": \"${CONFIG_DIR}/certmagic\" } }"
    fi
  else
    TLS_JSON="\"tls\": { \"enabled\": true, \"certificate_path\": \"${CONFIG_DIR}/cert/cert.pem\", \"key_path\": \"${CONFIG_DIR}/cert/private.key\" }"
  fi
}

# ==================== 证书生成 ====================
ssl_certificate() {
  local TLS_SERVER="$1"
  local CN_DOMAIN="$TLS_SERVER"
  local SAN_KIND="DNS"
  mkdir -p "${CONFIG_DIR}/cert"

  if [[ "$TLS_SERVER" =~ ^[0-9.]+$ || "$TLS_SERVER" =~ : ]]; then
    SAN_KIND="IP"
  fi

  if [[ ! -s "${CONFIG_DIR}/cert/ca.key" ]]; then
    print_info "生成 CA 私钥..."
    openssl ecparam -genkey -name prime256v1 -out "${CONFIG_DIR}/cert/ca.key"
  fi

  if [[ ! -s "${CONFIG_DIR}/cert/ca.crt" ]]; then
    print_info "生成 CA 根证书..."
    cat > "${CONFIG_DIR}/cert/ca.conf" <<EOF
[req]
distinguished_name = req_distinguished_name
x509_extensions = v3_ca
prompt = no
[req_distinguished_name]
CN = AnyTLS Root CA
[v3_ca]
basicConstraints = critical, CA:TRUE
keyUsage = critical, keyCertSign, cRLSign
EOF
    openssl req -new -x509 -days 36500 \
      -key "${CONFIG_DIR}/cert/ca.key" \
      -out "${CONFIG_DIR}/cert/ca.crt" \
      -config "${CONFIG_DIR}/cert/ca.conf"
    rm -f "${CONFIG_DIR}/cert/ca.conf"
  fi

  if [[ ! -s "${CONFIG_DIR}/cert/private.key" ]]; then
    print_info "生成服务器私钥..."
    openssl ecparam -genkey -name prime256v1 -out "${CONFIG_DIR}/cert/private.key"
  fi

  cat > "${CONFIG_DIR}/cert/server.conf" <<EOF
[req]
distinguished_name = req_distinguished_name
req_extensions = v3_req
prompt = no
[req_distinguished_name]
CN = ${CN_DOMAIN}
[v3_req]
subjectAltName = @alt_names
[alt_names]
${SAN_KIND}.1 = ${TLS_SERVER}
EOF

  openssl req -new \
    -key "${CONFIG_DIR}/cert/private.key" \
    -out "${CONFIG_DIR}/cert/server.csr" \
    -config "${CONFIG_DIR}/cert/server.conf"

  cat > "${CONFIG_DIR}/cert/ext.conf" <<EOF
basicConstraints = CA:FALSE
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = ${SAN_KIND}:${TLS_SERVER}
EOF

  openssl x509 -req -days 36500 \
    -in "${CONFIG_DIR}/cert/server.csr" \
    -CA "${CONFIG_DIR}/cert/ca.crt" \
    -CAkey "${CONFIG_DIR}/cert/ca.key" \
    -CAcreateserial \
    -out "${CONFIG_DIR}/cert/cert.pem" \
    -extfile "${CONFIG_DIR}/cert/ext.conf"

  rm -f "${CONFIG_DIR}/cert/server.conf" "${CONFIG_DIR}/cert/server.csr" \
        "${CONFIG_DIR}/cert/ext.conf" "${CONFIG_DIR}/cert/ca.srl"
  chmod 600 "${CONFIG_DIR}/cert/ca.key" "${CONFIG_DIR}/cert/private.key"
}

# ==================== 下载 sing-box ====================
download_singbox() {
  local DEST_BIN="${1:-/usr/local/bin/sing-box}"
  local TMP_DL=$(mktemp -d /tmp/sing-box.XXXXXX)
  local REL VER URL FILE

  REL=$(curl -s --connect-timeout 10 --max-time 20 "$GITHUB_API" 2>/dev/null || true)
  VER=$(echo "$REL" | jq -r '.tag_name' 2>/dev/null || true)

  if [[ -z "$VER" || "$VER" = "null" ]]; then
    rm -rf "$TMP_DL"
    return 1
  fi

  URL=$(echo "$REL" | jq -r ".assets[].browser_download_url" | grep -i "linux" | grep -i "$ARCH" | grep -v -i "sha256" | grep -v -i "v3" | head -1 || true)

  if [[ -z "$URL" ]]; then
    rm -rf "$TMP_DL"
    return 1
  fi

  wget --timeout=30 -q -O "${TMP_DL}/sing-box.pkg" "$URL" || {
    rm -rf "$TMP_DL"
    return 1
  }

  if [[ "$URL" == *.tar.gz ]]; then
    tar -xf "${TMP_DL}/sing-box.pkg" -C "${TMP_DL}"
  elif [[ "$URL" == *.zip ]]; then
    unzip -q -o "${TMP_DL}/sing-box.pkg" -d "${TMP_DL}"
  else
    cp "${TMP_DL}/sing-box.pkg" "${TMP_DL}/sing-box"
  fi

  FILE=$(find "${TMP_DL}" -type f -name "sing-box" | head -1)
  if [[ -z "$FILE" ]]; then
    rm -rf "$TMP_DL"
    return 1
  fi

  local TMP_BIN="${DEST_BIN}.tmp.$$"
  if ! cp "$FILE" "$TMP_BIN"; then
    rm -rf "$TMP_DL" "$TMP_BIN"
    return 1
  fi
  if ! chmod +x "$TMP_BIN"; then
    rm -rf "$TMP_DL" "$TMP_BIN"
    return 1
  fi
  if ! mv -f "$TMP_BIN" "$DEST_BIN"; then
    rm -rf "$TMP_DL" "$TMP_BIN"
    return 1
  fi
  rm -rf "$TMP_DL"
  echo "$VER" | sed 's/^v//'
}

# ==================== 清理垃圾 ====================
cleanup_old() {
  rm -f /usr/local/bin/sing-box.bak
  rm -f /usr/local/bin/sing-box.tmp.*
  rm -f "${CONFIG_DIR}"/*.tmp 2>/dev/null || true
  rm -rf /tmp/sing-box.* /tmp/anytls-* 2>/dev/null || true
  apt-get clean >/dev/null 2>&1 || true
}

# ==================== 防火墙配置 ====================
setup_ufw() {
  local PORT="$1"
  if ! command -v ufw >/dev/null 2>&1; then
    print_warn "未安装 UFW，跳过防火墙配置；请手动放行端口 ${PORT}/tcp"
    return 0
  fi
  print_info "配置防火墙 (UFW)..."
  systemctl unmask ufw >/dev/null 2>&1 || true
  systemctl enable --now ufw >/dev/null 2>&1 || true
  if [[ -f /etc/default/ufw ]]; then
    sed -i 's/IPV6=no/IPV6=yes/' /etc/default/ufw 2>/dev/null || true
  fi
  ufw --force reset >/dev/null 2>&1 || true
  ufw default deny incoming >/dev/null 2>&1 || true
  ufw default allow outgoing >/dev/null 2>&1 || true

  local SSH_PORT=22
  if [[ -f /etc/ssh/sshd_config ]]; then
    SSH_PORT=$(grep -Ei '^\s*Port\s+' /etc/ssh/sshd_config | head -1 | awk '{print $2}' | tr -d '\r\n' || true)
  fi
  if [[ -z "$SSH_PORT" ]] && [[ -d /etc/ssh/sshd_config.d ]]; then
    SSH_PORT=$(grep -Ei '^\s*Port\s+' /etc/ssh/sshd_config.d/*.conf 2>/dev/null | head -1 | awk '{print $2}' | tr -d '\r\n' || true)
  fi
  [[ "$SSH_PORT" =~ ^[0-9]+$ ]] || SSH_PORT=22

  ufw allow "${SSH_PORT}/tcp" comment 'SSH' >/dev/null 2>&1 || true
  ufw allow "${PORT}/tcp" comment 'AnyTLS TCP' >/dev/null 2>&1 || true
  ufw allow "${PORT}/udp" comment 'AnyTLS UDP' >/dev/null 2>&1 || true
  if [[ "$(get_cert_mode)" == "acme" ]]; then
    ufw allow 80/tcp comment 'ACME HTTP' >/dev/null 2>&1 || true
    ufw allow 443/tcp comment 'ACME TLS' >/dev/null 2>&1 || true
  fi
  ufw --force enable >/dev/null 2>&1 || true
  ufw reload >/dev/null 2>&1 || true
  judge "UFW 防火墙配置"
}

# ==================== 定时任务 ====================
setup_cron() {
  local CLEAN_SCRIPT="/usr/local/bin/anytls-cleanup.sh"

  cat > "$CLEAN_SCRIPT" <<'EOF'
#!/bin/bash

set -e

# apt 缓存与残留依赖
apt-get clean >/dev/null 2>&1 || true
apt-get autoclean -y >/dev/null 2>&1 || true
apt-get autoremove -y >/dev/null 2>&1 || true

# systemd 日志：保留最近 7 天且总大小不超过 50M
journalctl --vacuum-time=7d --vacuum-size=50M >/dev/null 2>&1 || true

# 临时文件：只删 7 天以上的普通文件，再删 7 天以上的空目录，避免误删里面还有新文件的目录
find /tmp /var/tmp -mindepth 1 -type f -mtime +7 -delete >/dev/null 2>&1 || true
find /tmp /var/tmp -mindepth 1 -type d -mtime +7 -empty -delete >/dev/null 2>&1 || true

# sing-box 更新残留
rm -f /usr/local/bin/sing-box.bak >/dev/null 2>&1 || true
rm -f /usr/local/bin/sing-box.tmp.* >/dev/null 2>&1 || true
rm -f /etc/anytls/*.tmp >/dev/null 2>&1 || true
rm -rf /tmp/sing-box.* /tmp/anytls-* >/dev/null 2>&1 || true

# 清理 systemd 失败状态
systemctl reset-failed >/dev/null 2>&1 || true

exit 0
EOF

  chmod +x "$CLEAN_SCRIPT"

  cat > "$CRON_CLEAN" <<EOF
7 7 * * 0 root $CLEAN_SCRIPT >/dev/null 2>&1
EOF

  chmod 644 "$CRON_CLEAN"

  judge "定时任务配置"
}

# ==================== 导出节点信息 ====================
export_client_info() {
  local PORT="$1" PASS="$2" SNI="$3" NAME="$4"
  check_system_ip

  local CERT_MODE_NOW=$(get_cert_mode)
  local FINGERPRINT_SHA256="" PUBKEY_B64=""
  if [[ "$CERT_MODE_NOW" != "acme" ]]; then
    local CERT_FILE="${CONFIG_DIR}/cert/cert.pem"
    FINGERPRINT_SHA256=$(openssl x509 -fingerprint -noout -sha256 -in "$CERT_FILE" 2>/dev/null | awk -F '=' '{print $NF}' | tr -d ':')
    if [[ -s "$CERT_FILE" ]] && command -v openssl >/dev/null 2>&1; then
      PUBKEY_B64=$(openssl x509 -in "$CERT_FILE" -pubkey -noout 2>/dev/null | openssl pkey -pubin -outform der 2>/dev/null | openssl dgst -sha256 -binary 2>/dev/null | openssl enc -base64 -A 2>/dev/null)
    fi
  fi

  local PASS_ENC NAME_ENC SNI_ENC
  if command -v jq >/dev/null 2>&1; then
    PASS_ENC=$(jq -rn --arg v "$PASS" '$v|@uri')
    NAME_ENC=$(jq -rn --arg v "$NAME" '$v|@uri')
    SNI_ENC=$(jq -rn --arg v "$SNI" '$v|@uri')
  else
    PASS_ENC="${PASS// /%20}"
    NAME_ENC="${NAME// /%20}"
    SNI_ENC="${SNI// /%20}"
  fi

  local URI_V4="" URI_V6=""
  local QUERY="sni=${SNI_ENC}&udp=1"
  if [[ "$CERT_MODE_NOW" != "acme" ]]; then
    QUERY="${QUERY}&insecure=1&allowInsecure=1"
  fi
  if [[ -n "$IPV4" ]]; then
    URI_V4="anytls://${PASS_ENC}@${IPV4}:${PORT}?${QUERY}#${NAME_ENC}"
  fi
  if [[ -n "$IPV6" ]]; then
    URI_V6="anytls://${PASS_ENC}@[${IPV6}]:${PORT}?${QUERY}#${NAME_ENC}"
  fi

  {
    echo "=========== AnyTLS (sing-box) 配置参数 ==========="
    echo " 服务器: ${MAIN_IP:-未知}"
    echo " IPv4: ${IPV4:-无}"
    echo " IPv6: ${IPV6:-无}"
    echo " 端口: ${PORT}"
    echo " 密码: ${PASS}"
    echo " SNI: ${SNI}"
    if [[ "$CERT_MODE_NOW" == "acme" ]]; then
      echo " 证书: Let's Encrypt 自动续期"
    else
      if [[ -n "$FINGERPRINT_SHA256" ]]; then
        echo " 证书指纹 (SHA-256): ${FINGERPRINT_SHA256}"
      fi
      if [[ -n "$PUBKEY_B64" ]]; then
        echo " 证书公钥指纹 (sing-box pinSHA256): ${PUBKEY_B64}"
      fi
    fi
    echo " sing-box 版本: $(get_local_version)"
    echo "=================================================="
    echo ""
    if [[ "$CERT_MODE_NOW" == "acme" ]]; then
      echo " 节点链接使用真实证书，无需 insecure，可直接导入。"
    else
      echo " 节点链接说明: 自签证书 + insecure=1 可直接导入；"
      echo " 如需证书固定，请在 sing-box 客户端用 certificate_public_key_sha256 填入上面的 base64 公钥指纹。"
    fi
    if [[ -n "$URI_V4" ]]; then
      echo -e "\n【IPv4 节点链接】\n${URI_V4}"
    fi
    if [[ -n "$URI_V6" ]]; then
      echo -e "\n【IPv6 节点链接】\n${URI_V6}"
    fi
  } > "$LIST_FILE"
}

# ==================== 快捷命令配置 ====================
create_shortcut() {
  local PANEL="/usr/local/bin/anytls-panel.sh"
  local PANEL_BAK="${CONFIG_DIR}/anytls-panel.sh"
  local SRC=""

  mkdir -p "$CONFIG_DIR"

  # 1. 优先尝试定位当前脚本所在路径
  for candidate in "${BASH_SOURCE[0]:-}" "$0"; do
    if [[ -n "$candidate" && -f "$candidate" && -r "$candidate" ]]; then
      if grep -q "AnyTLS (sing-box) 一键管理脚本" "$candidate" 2>/dev/null; then
        SRC="$candidate"
        break
      fi
    fi
  done

  if [[ -n "$SRC" ]]; then
    # FIX: 避免源文件与目标文件为同一物理文件时 cp 报错退出
    if [[ "$SRC" -ef "$PANEL" ]] || [[ "$SRC" == "$PANEL" ]]; then
      chmod +x "$PANEL"
    else
      cp -f "$SRC" "$PANEL"
      chmod +x "$PANEL"
    fi
    if [[ ! "$PANEL" -ef "$PANEL_BAK" ]]; then
      cp -f "$PANEL" "$PANEL_BAK" 2>/dev/null || true
    fi
    print_ok "面板脚本已成功保存"
  elif [[ -n "${SCRIPT_URL:-}" ]]; then
    print_info "尝试从远程 URL 下载脚本保存面板..."
    if curl -sSL --connect-timeout 10 -o "$PANEL" "$SCRIPT_URL" 2>/dev/null || wget -q -O "$PANEL" "$SCRIPT_URL" 2>/dev/null; then
      chmod +x "$PANEL"
      if [[ ! "$PANEL" -ef "$PANEL_BAK" ]]; then
        cp -f "$PANEL" "$PANEL_BAK" 2>/dev/null || true
      fi
      print_ok "已从远程下载并保存面板脚本"
    fi
  fi

  # 2. 补全互备路径
  if [[ ! -s "$PANEL" && -s "$PANEL_BAK" ]]; then
    if [[ ! "$PANEL_BAK" -ef "$PANEL" ]]; then
      cp -f "$PANEL_BAK" "$PANEL"
      chmod +x "$PANEL"
    fi
  elif [[ -s "$PANEL" && ! -s "$PANEL_BAK" ]]; then
    if [[ ! "$PANEL" -ef "$PANEL_BAK" ]]; then
      cp -f "$PANEL" "$PANEL_BAK"
    fi
  fi

  if [[ ! -s "$PANEL" ]]; then
    print_warn "未能自动保留面板脚本文件。"
    print_warn "提示：通过管道 (curl | bash) 运行脚本时，建议先下载脚本文件到本地，例如："
    print_warn "      wget -O anytls.sh <脚本URL> && chmod +x anytls.sh && ./anytls.sh"
  fi

  # 3. 创建快捷指令 a
  cat > /usr/local/bin/a <<'EOF'
#!/bin/bash
