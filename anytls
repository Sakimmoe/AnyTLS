#!/bin/bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

ANYTLS_PORT='26216'
ANYTLS_PASSWORD=''
NODE_NAME=''
DOMAIN=''
WORK_DIR='/etc/anytls'
GITHUB_API="https://api.github.com/repos/anytls/anytls-go/releases/latest"

info() { echo -e "\033[32m\033[01m$*\033[0m"; }
hint() { echo -e "\033[33m\033[01m$*\033[0m"; }
warning() { echo -e "\033[31m\033[01m$*\033[0m"; }
reading() { read -rp "$(info "$1")" "$2"; }

generate_selfsigned_cert() {
  local CN="$1"
  mkdir -p "${WORK_DIR}/cert"
  
  cat > "${WORK_DIR}/cert/ext.cnf" << EOF
basicConstraints = CA:FALSE
keyUsage = nonRepudiation, digitalSignature, keyEncipherment
subjectAltName = @alt_names

[alt_names]
DNS.1 = ${CN}
IP.1 = 0.0.0.0
IP.2 = ::
EOF

  openssl req -x509 -nodes -days 3650 \
    -newkey ec:<(openssl ecparam -name prime256v1) \
    -keyout "${WORK_DIR}/cert/server.key" \
    -out "${WORK_DIR}/cert/server.crt" \
    -subj "/CN=${CN}" \
    -config <(cat << HEREDOC
[req]
distinguished_name = req_distinguished_name
x509_extensions = v3_req
prompt = no

[req_distinguished_name]
CN = ${CN}

[v3_req]
keyUsage = keyEncipherment, dataEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @alt_names

[alt_names]
DNS.1 = ${CN}
IP.1 = 0.0.0.0
IP.2 = ::
HEREDOC
) 2>/dev/null

  rm -f "${WORK_DIR}/cert/ext.cnf"
  
  CERT_FINGERPRINT=$(openssl x509 -in "${WORK_DIR}/cert/server.crt" -pubkey -noout | \
    openssl pkey -pubin -outform der | \
    openssl dgst -sha256 -binary | \
    openssl enc -base64)
  
  CERT_SHA256=$(openssl x509 -fingerprint -noout -sha256 -in "${WORK_DIR}/cert/server.crt" | awk -F= '{print $2}')
}

check_system_ip() {
  IPV4=$(curl -4 -s --max-time 5 https://api.ipify.org 2>/dev/null || echo "")
  IPV6=$(curl -6 -s --connect-timeout 3 https://api64.ipify.org 2>/dev/null || echo "")
  MAIN_IP=$([ -n "$IPV4" ] && echo "$IPV4" || echo "$IPV6")
}

echo "=========================================="
echo " AnyTLS 一键部署脚本"
echo "=========================================="

if [ "$EUID" -ne 0 ]; then
    warning "请使用 root 用户运行"
    exit 1
fi

echo "清理旧配置..."
systemctl stop anytls stunnel4 2>/dev/null || true
systemctl disable anytls stunnel4 2>/dev/null || true
rm -f /etc/systemd/system/anytls.service
rm -f /usr/local/bin/anytls-server
rm -rf /etc/anytls
rm -f /etc/cron.d/anytls-cleanup
ufw delete allow 443/tcp 2>/dev/null || true
ufw delete allow 443/udp 2>/dev/null || true
systemctl daemon-reload 2>/dev/null || true

echo "安装依赖..."
apt-get update -qq >/dev/null 2>&1 || true
apt-get install -y -qq wget unzip curl ufw iproute2 cron jq tar openssl stunnel4 >/dev/null 2>&1 || true

echo "优化网络配置..."
grep -q "precedence ::ffff:0:0/96 100" /etc/gai.conf 2>/dev/null || echo "precedence ::ffff:0:0/96 100" >> /etc/gai.conf
systemctl disable systemd-resolved --now >/dev/null 2>&1 || true
systemctl mask systemd-resolved >/dev/null 2>&1 || true
chattr -i /etc/resolv.conf >/dev/null 2>&1 || true
rm -f /etc/resolv.conf >/dev/null 2>&1 || true
cat > /etc/resolv.conf << 'EOF'
nameserver 1.1.1.1
nameserver 8.8.8.8
nameserver 2606:4700:4700::1111
nameserver 2001:4860:4860::8888
EOF
chattr +i /etc/resolv.conf >/dev/null 2>&1 || true
cat > /etc/sysctl.d/99-bbr.conf << 'EOF'
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
EOF
sysctl --system >/dev/null 2>&1 || true

check_system_ip
if [ -z "$MAIN_IP" ]; then
    warning "无法获取服务器 IP"
    exit 1
fi

hint ""
hint "当前服务器 IP: ${MAIN_IP}"
hint ""

reading "请输入 AnyTLS 密码（留空则随机生成）: " ANYTLS_PASSWORD
[ -z "$ANYTLS_PASSWORD" ] && ANYTLS_PASSWORD=$(cat /proc/sys/kernel/random/uuid) && hint "已生成随机密码: ${ANYTLS_PASSWORD}"

DEFAULT_NAME=$(hostname 2>/dev/null || echo "AnyTLS")
reading "请输入节点名称 [默认: ${DEFAULT_NAME}]: " NODE_NAME
NODE_NAME=${NODE_NAME:-$DEFAULT_NAME}

reading "请输入你的域名（没有就留空，直接用 IP）: " DOMAIN

if [ -n "$DOMAIN" ]; then
  SNI="$DOMAIN"
  hint "使用域名作为证书 CN: ${DOMAIN}"
else
  SNI="${MAIN_IP}"
  hint "使用 IP 作为证书 CN: ${MAIN_IP}"
fi

generate_selfsigned_cert "$SNI"

echo "下载 AnyTLS..."
case "$(uname -m)" in
    x86_64|amd64) ARCH="amd64" ;;
    aarch64|arm64) ARCH="arm64" ;;
    *) warning "不支持的架构: $(uname -m)"; exit 1 ;;
esac

RELEASE_INFO=$(curl -s --connect-timeout 10 --max-time 20 ${GITHUB_API})
VERSION=$(echo "$RELEASE_INFO" | jq -r '.tag_name' 2>/dev/null || true)
[ -z "$VERSION" ] || [ "$VERSION" = "null" ] && { warning "获取版本失败"; exit 1; }

ASSET_URL=$(echo "$RELEASE_INFO" | jq -r ".assets[].browser_download_url" | grep -i "linux" | grep -i "${ARCH}" | grep -v -i "sha256" | head -1 || true)
[ -z "$ASSET_URL" ] && { warning "未找到下载文件"; exit 1; }

TMP=$(mktemp -d)
wget --timeout=30 -q -O "${TMP}/anytls.pkg" "$ASSET_URL" || { warning "下载失败"; rm -rf "${TMP}"; exit 1; }

rm -f /usr/local/bin/anytls-server
if [[ "$ASSET_URL" == *.tar.gz ]]; then
    tar -xf "${TMP}/anytls.pkg" -C "${TMP}"
elif [[ "$ASSET_URL" == *.zip ]]; then
    unzip -q -o "${TMP}/anytls.pkg" -d "${TMP}"
else
    cp "${TMP}/anytls.pkg" "${TMP}/anytls-server"
fi

FILE=$(find "${TMP}" -type f -name "anytls-server" | head -1)
cp "$FILE" /usr/local/bin/anytls-server
chmod +x /usr/local/bin/anytls-server
rm -rf "${TMP}"

cat > /etc/systemd/system/anytls.service << EOF
[Unit]
Description=AnyTLS Server
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/anytls-server -l 127.0.0.1:${ANYTLS_PORT} -p ${ANYTLS_PASSWORD}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

cat > /etc/stunnel/stunnel.conf << EOF
pid = /var/run/stunnel4.pid
foreground = no

[anytls]
accept = :::443
connect = 127.0.0.1:${ANYTLS_PORT}
cert = ${WORK_DIR}/cert/server.crt
key = ${WORK_DIR}/cert/server.key
EOF

if [ -f /etc/default/stunnel4 ]; then
    sed -i 's/ENABLED=0/ENABLED=1/' /etc/default/stunnel4
fi

systemctl daemon-reload
systemctl enable anytls stunnel4 >/dev/null 2>&1 || true
systemctl restart anytls stunnel4 >/dev/null 2>&1 || true
sleep 2

if ! systemctl is-active --quiet anytls; then
    warning "AnyTLS 启动失败"; journalctl -u anytls -n 10 --no-pager; exit 1
fi
if ! systemctl is-active --quiet stunnel4; then
    warning "stunnel4 启动失败"; journalctl -u stunnel4 -n 10 --no-pager; exit 1
fi

echo "配置防火墙..."
systemctl unmask ufw >/dev/null 2>&1 || true
systemctl enable --now ufw >/dev/null 2>&1 || true
ufw --force reset >/dev/null 2>&1 || true
ufw default deny incoming >/dev/null 2>&1 || true
ufw default allow outgoing >/dev/null 2>&1 || true

SSH_PORT=22
if [ -f /etc/ssh/sshd_config ]; then
    _p=$(grep -Ei '^\s*Port\s+' /etc/ssh/sshd_config | head -1 | awk '{print $2}' | tr -d '\r\n' || true)
    [ -n "$_p" ] && SSH_PORT="$_p"
fi

ufw allow ${SSH_PORT}/tcp comment 'SSH' >/dev/null 2>&1 || true
ufw allow 443/tcp comment 'AnyTLS' >/dev/null 2>&1 || true
ufw allow 443/udp comment 'AnyTLS' >/dev/null 2>&1 || true
ufw --force enable >/dev/null 2>&1 || true

cat > /etc/cron.d/anytls-cleanup << 'CRONEOF'
7 7 * * 0 root /bin/bash -c 'apt-get clean && apt-get autoclean -y && apt-get autoremove -y && rm -rf /var/lib/apt/lists/* && journalctl --vacuum-time=5d --vacuum-size=30M && find /tmp /var/tmp -type f -mtime +7 -delete' >/dev/null 2>&1
CRONEOF
chmod 644 /etc/cron.d/anytls-cleanup

echo ""
echo "=========================================="
info " AnyTLS 部署完成"
echo "=========================================="
info " 服务器 IP : ${MAIN_IP}"
info " 端口      : 443"
info " 密码      : ${ANYTLS_PASSWORD}"
info " SNI       : ${SNI}"
info " 版本      : ${VERSION}"
echo "=========================================="
echo ""

hint "【推荐】Sing-box 客户端配置（证书指纹校验，无需证书文件）"
cat << EOF
{
    "type": "anytls",
    "tag": "${NODE_NAME}",
    "server": "${MAIN_IP}",
    "server_port": 443,
    "password": "${ANYTLS_PASSWORD}",
    "idle_session_check_interval": "30s",
    "idle_session_timeout": "30s",
    "min_idle_session": 5,
    "tls": {
        "enabled": true,
        "server_name": "${SNI}",
        "certificate_public_key_sha256": ["${CERT_FINGERPRINT}"],
        "utls": {
            "enabled": true,
            "fingerprint": "chrome"
        }
    }
}
EOF
echo ""

hint "【备用】Sing-box 客户端配置（跳过证书验证，仅测试用）"
cat << EOF
{
    "type": "anytls",
    "tag": "${NODE_NAME}",
    "server": "${MAIN_IP}",
    "server_port": 443,
    "password": "${ANYTLS_PASSWORD}",
    "idle_session_check_interval": "30s",
    "idle_session_timeout": "30s",
    "min_idle_session": 5,
    "tls": {
        "enabled": true,
        "server_name": "${SNI}",
        "insecure": true,
        "utls": {
            "enabled": true,
            "fingerprint": "chrome"
        }
    }
}
EOF
echo ""

hint "【节点 URI】"
echo "anytls://${ANYTLS_PASSWORD}@${MAIN_IP}:443?peer=${SNI}&udp=1&hpkp=${CERT_SHA256}#${NODE_NAME// /%20}"
echo ""
echo "=========================================="
