#!/bin/bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

DOMAIN=${1:-}
ANYTLS_PORT=${2:-443}
ANYTLS_PASSWORD=${3:-kokonoeyukari}
NET_MODE=${4:-dual}

GITHUB_API="https://api.github.com/repos/anytls/anytls-go/releases/latest"

echo "=========================================="
echo " AnyTLS CA证书安全部署脚本"
echo " IPv4 / IPv6 / Dual Stack"
echo "=========================================="


if [ "$EUID" -ne 0 ]; then
    echo "错误: 请使用 root 用户运行"
    exit 1
fi


if [ -z "$DOMAIN" ]; then
    echo
    echo "用法:"
    echo "bash anytls 域名 [端口] [密码] [模式]"
    echo
    echo "模式:"
    echo "dual  双栈(默认)"
    echo "ipv4  IPv4"
    echo "ipv6  IPv6"
    exit 1
fi


case "$NET_MODE" in
    dual)
        LISTEN_ADDR="[::]"
        ;;
    ipv4)
        LISTEN_ADDR="0.0.0.0"
        ;;
    ipv6)
        LISTEN_ADDR="[::]"
        ;;
    *)
        echo "错误: 网络模式只能是 dual ipv4 ipv6"
        exit 1
        ;;
esac



echo "1. 安装依赖..."

apt-get update -qq >/dev/null 2>&1 || true

apt-get install -y -qq \
wget \
curl \
unzip \
jq \
tar \
ufw \
cron \
ca-certificates \
socat \
iproute2 >/dev/null 2>&1



echo "2. 开启 BBR..."

cat >/etc/sysctl.d/99-bbr.conf <<EOF
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
EOF

sysctl --system >/dev/null 2>&1 || true



echo "3. 配置防火墙..."

systemctl enable --now ufw >/dev/null 2>&1 || true

ufw --force reset >/dev/null 2>&1 || true

ufw default deny incoming >/dev/null 2>&1 || true
ufw default allow outgoing >/dev/null 2>&1 || true


SSH_PORT=$(grep -Ei '^\s*Port\s+' /etc/ssh/sshd_config 2>/dev/null \
| head -1 \
| awk '{print $2}' || echo 22)


if ! [[ "$SSH_PORT" =~ ^[0-9]+$ ]]; then
    SSH_PORT=22
fi


ufw allow 22/tcp comment "SSH fallback" >/dev/null 2>&1 || true
ufw allow ${SSH_PORT}/tcp comment "SSH" >/dev/null 2>&1 || true

# ACME
ufw allow 80/tcp comment "LetsEncrypt" >/dev/null 2>&1 || true

# AnyTLS TCP
ufw allow ${ANYTLS_PORT}/tcp comment "AnyTLS" >/dev/null 2>&1 || true


ufw --force enable >/dev/null 2>&1 || true
ufw reload >/dev/null 2>&1 || true



echo "4. 安装 acme.sh..."

if [ ! -f ~/.acme.sh/acme.sh ]; then

curl https://get.acme.sh | sh -s email=admin@${DOMAIN}

fi


~/.acme.sh/acme.sh \
--set-default-ca \
--server letsencrypt >/dev/null 2>&1



echo "申请 Let's Encrypt 证书..."



# 根据模式选择验证监听

if [ "$NET_MODE" = "ipv4" ]; then

    ~/.acme.sh/acme.sh \
    --issue \
    -d ${DOMAIN} \
    --standalone \
    --listen-v4


elif [ "$NET_MODE" = "ipv6" ]; then

    ~/.acme.sh/acme.sh \
    --issue \
    -d ${DOMAIN} \
    --standalone \
    --listen-v6


else

    ~/.acme.sh/acme.sh \
    --issue \
    -d ${DOMAIN} \
    --standalone

fi



echo "安装证书..."

mkdir -p /etc/anytls


~/.acme.sh/acme.sh \
--installcert \
-d ${DOMAIN} \
--key-file /etc/anytls/server.key \
--fullchain-file /etc/anytls/server.crt



echo "5. 下载 AnyTLS..."

case "$(uname -m)" in

x86_64|amd64)
ARCH="amd64"
;;

aarch64|arm64)
ARCH="arm64"
;;

*)
echo "不支持架构"
exit 1
;;

esac



RELEASE_INFO=$(curl -s \
--connect-timeout 10 \
--max-time 20 \
${GITHUB_API})


VERSION=$(echo "$RELEASE_INFO" \
| jq -r '.tag_name')



if [ "$VERSION" = "null" ] || [ -z "$VERSION" ]; then

echo "获取版本失败"

exit 1

fi



ASSET_URL=$(echo "$RELEASE_INFO" \
| jq -r '.assets[].browser_download_url' \
| grep linux \
| grep ${ARCH} \
| grep -v sha256 \
| head -1)



if [ -z "$ASSET_URL" ]; then

echo "找不到对应版本"

exit 1

fi



TMP=$(mktemp -d)



wget -q \
-O ${TMP}/anytls.pkg \
"$ASSET_URL"



rm -f /usr/local/bin/anytls-server



if [[ "$ASSET_URL" == *.tar.gz ]]; then

tar -xf ${TMP}/anytls.pkg -C ${TMP}


elif [[ "$ASSET_URL" == *.zip ]]; then

unzip -q -o ${TMP}/anytls.pkg -d ${TMP}


else

cp ${TMP}/anytls.pkg ${TMP}/anytls-server

fi



FILE=$(find ${TMP} \
-type f \
-name anytls-server \
| head -1)



if [ -z "$FILE" ]; then

echo "没有找到 anytls-server"

exit 1

fi



cp "$FILE" /usr/local/bin/anytls-server

chmod +x /usr/local/bin/anytls-server


rm -rf ${TMP}




echo "6. 创建服务..."

cat >/etc/systemd/system/anytls.service <<EOF

[Unit]
Description=AnyTLS Secure Server
After=network.target


[Service]

Type=simple

LimitNOFILE=65535

ExecStart=/usr/local/bin/anytls-server \
-l ${LISTEN_ADDR}:${ANYTLS_PORT} \
-p ${ANYTLS_PASSWORD} \
-cert /etc/anytls/server.crt \
-key /etc/anytls/server.key


Restart=always

RestartSec=3



[Install]

WantedBy=multi-user.target

EOF



systemctl daemon-reload

systemctl enable anytls >/dev/null 2>&1

systemctl restart anytls



sleep 3



if ! systemctl is-active --quiet anytls; then

echo "AnyTLS启动失败"

journalctl -u anytls -n 30 --no-pager

exit 1

fi



echo "7. 配置证书自动续期..."

~/.acme.sh/acme.sh \
--install-cert \
-d ${DOMAIN} \
--reloadcmd "systemctl restart anytls"



echo

echo "=========================================="

echo " AnyTLS 部署完成"

echo "=========================================="

echo "域名 : ${DOMAIN}"

echo "端口 : ${ANYTLS_PORT}"

echo "密码 : ${ANYTLS_PASSWORD}"

echo "模式 : ${NET_MODE}"

echo "监听 : ${LISTEN_ADDR}"

echo "证书 : Let's Encrypt CA"

echo

echo "客户端地址:"

echo "anytls://${ANYTLS_PASSWORD}@${DOMAIN}:${ANYTLS_PORT}"

echo

echo "=========================================="
