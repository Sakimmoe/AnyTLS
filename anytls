#!/bin/bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

# ---------- 参数解析 ----------
ANYTLS_PORT=${1:-26216}
ANYTLS_PASSWORD=${2:-kokonoeyukari}
NET_MODE_RAW=${3:-}
EMAIL=${4:-}
DOMAIN=${5:-}

# 规范化 NET_MODE（大小写不敏感，支持 dual/ipv4/ipv6/4/6）
NET_MODE=$(echo "$NET_MODE_RAW" | tr '[:upper:]' '[:lower:]')
case "$NET_MODE" in
    dual)   NET_MODE="dual" ;;
    4|ipv4) NET_MODE="4" ;;
    6|ipv6) NET_MODE="6" ;;
    "")     NET_MODE="" ;;   # 默认双栈
    *)
        echo "错误: 网络模式只能是 dual / ipv4 / ipv6 (或 4 / 6)"
        exit 1
        ;;
esac

GITHUB_API="https://api.github.com/repos/anytls/anytls-go/releases/latest"

echo "=========================================="
echo " AnyTLS TLS 证书 + 双节点部署脚本"
echo "=========================================="

if [ "$EUID" -ne 0 ]; then
    echo "Error: 请使用 root 用户运行"
    exit 1
fi

if [ -z "$EMAIL" ] || [ -z "$DOMAIN" ]; then
    echo "Error: 必须提供邮箱和域名"
    echo "用法：$0 [端口] [密码] [模式] 邮箱 域名"
    echo "示例：$0 26216 mypass dual my@mail.com my.domain.com"
    exit 1
fi

if ! echo "$EMAIL" | grep -qE "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$"; then
    echo "Error: 邮箱格式不正确"
    exit 1
fi

echo "1. 安装依赖..."
apt-get update -qq
apt-get install -y -qq wget unzip curl ufw iproute2 cron jq tar socat

echo "2. 网络优化 & BBR..."
grep -q "precedence ::ffff:0:0/96 100" /etc/gai.conf 2>/dev/null || echo "precedence ::ffff:0:0/96 100" >> /etc/gai.conf

systemctl disable systemd-resolved --now >/dev/null 2>&1 || true
systemctl mask systemd-resolved >/dev/null 2>&1 || true
chattr -i /etc/resolv.conf >/dev/null 2>&1 || true
rm -f /etc/resolv.conf
cat > /etc/resolv.conf << EOF
nameserver 1.1.1.1
nameserver 8.8.8.8
nameserver 2606:4700:4700::1111
nameserver 2001:4860:4860::8888
EOF
chattr +i /etc/resolv.conf >/dev/null 2>&1 || true

cat > /etc/sysctl.d/99-bbr.conf << 'EOF'
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
EOF
sysctl --system >/dev/null 2>&1

echo "3. 检测服务器 IP..."
IPV4=$(curl -4 -s --max-time 5 https://api.ipify.org || echo "无")
IPV6=$(curl -6 -s --connect-timeout 3 https://api64.ipify.org || echo "无")

# ---------- 部署模式 ----------
if [ "$NET_MODE" = "dual" ]; then
    DEPLOY_DUAL=true
    V4_PORT=$ANYTLS_PORT
    V6_PORT=$((ANYTLS_PORT + 1))
    echo "双节点模式：IPv4 端口 $V4_PORT, IPv6 端口 $V6_PORT"
else
    DEPLOY_DUAL=false
    if [ "$NET_MODE" = "4" ]; then
        LISTEN_ADDR="0.0.0.0"
        echo "纯 IPv4 模式"
    elif [ "$NET_MODE" = "6" ]; then
        LISTEN_ADDR="[::]"
        echo "纯 IPv6 模式"
    else
        LISTEN_ADDR="[::]"
        echo "双栈模式 (监听 [::])"
    fi
fi

# ---------- 安装 acme.sh ----------
echo "4. 安装 acme.sh..."
curl -s https://get.acme.sh | sh -s email="$EMAIL"
export PATH="$HOME/.acme.sh:$PATH"
[ -f ~/.bashrc ] && source ~/.bashrc

# ---------- 申请证书 ----------
echo "5. 申请 Let's Encrypt 证书（域名: $DOMAIN）..."
# 停止可能占用 80 端口的服务
systemctl stop nginx apache2 2>/dev/null || true

~/.acme.sh/acme.sh --issue --standalone -d "$DOMAIN" \
    --email "$EMAIL" \
    --keylength ec-256 \
    --force

CERT_DIR="/etc/anytls/certs"
mkdir -p "$CERT_DIR"
~/.acme.sh/acme.sh --install-cert -d "$DOMAIN" \
    --ecc \
    --key-file       "$CERT_DIR/private.key" \
    --fullchain-file "$CERT_DIR/fullchain.crt" \
    --reloadcmd     "systemctl restart anytls4 anytls6 anytls 2>/dev/null || true"

echo "证书已安装至: $CERT_DIR"

# ---------- 下载 anytls ----------
echo "6. 部署 AnyTLS..."
systemctl stop anytls anytls4 anytls6 2>/dev/null || true
sleep 1

check_port() {
    if ss -tlnp | grep -q ":${1} "; then
        echo "Error: 端口 ${1} 已被占用"
        ss -tlnp | grep ":${1} "
        exit 1
    fi
}
if $DEPLOY_DUAL; then
    check_port $V4_PORT
    check_port $V6_PORT
else
    check_port $ANYTLS_PORT
fi

case "$(uname -m)" in
    x86_64|amd64) ARCH="amd64" ;;
    aarch64|arm64) ARCH="arm64" ;;
    *) echo "不支持的架构"; exit 1 ;;
esac

echo "获取 AnyTLS 最新版本..."
RELEASE_INFO=$(curl -s --connect-timeout 10 --max-time 20 ${GITHUB_API})
VERSION=$(echo "$RELEASE_INFO" | jq -r '.tag_name')
if [ -z "$VERSION" ] || [ "$VERSION" = "null" ]; then
    echo "获取版本失败，请检查网络"
    exit 1
fi
echo "当前 AnyTLS 版本: ${VERSION}"

BASE_URL="https://github.com/anytls/anytls-go/releases/download/${VERSION}"
TMP=$(mktemp -d)
DOWNLOAD_SUCCESS=false
echo "尝试下载 anytls-server-linux-${ARCH}.tar.gz ..."
if wget --timeout=30 -q -O "${TMP}/anytls.tar.gz" "${BASE_URL}/anytls-server-linux-${ARCH}.tar.gz"; then
    tar -xzf "${TMP}/anytls.tar.gz" -C "${TMP}"
    DOWNLOAD_SUCCESS=true
else
    echo "尝试下载 anytls-server-linux-${ARCH}.zip ..."
    if wget --timeout=30 -q -O "${TMP}/anytls.zip" "${BASE_URL}/anytls-server-linux-${ARCH}.zip"; then
        unzip -q -o "${TMP}/anytls.zip" -d "${TMP}"
        DOWNLOAD_SUCCESS=true
    fi
fi
if [ "$DOWNLOAD_SUCCESS" = false ]; then
    echo "AnyTLS 下载失败"
    rm -rf "${TMP}"
    exit 1
fi

FILE=$(find "${TMP}" -type f -name "anytls-server" | head -1)
if [ -z "$FILE" ]; then
    echo "解压后未找到二进制文件"
    rm -rf "${TMP}"
    exit 1
fi
cp "$FILE" /usr/local/bin/anytls-server
chmod +x /usr/local/bin/anytls-server
rm -rf "${TMP}"

# ---------- systemd 服务 ----------
CERT_OPTS="-c $CERT_DIR/fullchain.crt -k $CERT_DIR/private.key"

if $DEPLOY_DUAL; then
    cat > /etc/systemd/system/anytls4.service << EOF
[Unit]
Description=AnyTLS IPv4 Service
After=network.target

[Service]
Type=simple
LimitNOFILE=65535
ExecStart=/usr/local/bin/anytls-server -l 0.0.0.0:${V4_PORT} -p ${ANYTLS_PASSWORD} ${CERT_OPTS}
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
EOF

    cat > /etc/systemd/system/anytls6.service << EOF
[Unit]
Description=AnyTLS IPv6 Service
After=network.target

[Service]
Type=simple
LimitNOFILE=65535
ExecStart=/usr/local/bin/anytls-server -l [::]:${V6_PORT} -p ${ANYTLS_PASSWORD} ${CERT_OPTS}
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable anytls4 anytls6
    systemctl restart anytls4 anytls6
    sleep 2

    systemctl is-active --quiet anytls4 || { echo "IPv4 服务启动失败"; journalctl -u anytls4 -n 20 --no-pager; exit 1; }
    systemctl is-active --quiet anytls6 || { echo "IPv6 服务启动失败"; journalctl -u anytls6 -n 20 --no-pager; exit 1; }
else
    cat > /etc/systemd/system/anytls.service << EOF
[Unit]
Description=AnyTLS Server Service
After=network.target

[Service]
Type=simple
LimitNOFILE=65535
ExecStart=/usr/local/bin/anytls-server -l ${LISTEN_ADDR}:${ANYTLS_PORT} -p ${ANYTLS_PASSWORD} ${CERT_OPTS}
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable anytls
    systemctl restart anytls
    sleep 2
    systemctl is-active --quiet anytls || { echo "AnyTLS 启动失败"; journalctl -u anytls -n 20 --no-pager; exit 1; }
fi

# ---------- 防火墙 ----------
echo "7. 配置防火墙..."
systemctl unmask ufw >/dev/null 2>&1 || true
systemctl enable --now ufw >/dev/null 2>&1 || true
ufw --force reset
ufw default deny incoming
ufw default allow outgoing

SSH_PORT=""
[ -f /etc/ssh/sshd_config ] && SSH_PORT=$(grep -Ei '^\s*Port\s+' /etc/ssh/sshd_config | head -1 | awk '{print $2}')
[ -z "$SSH_PORT" ] && [ -d /etc/ssh/sshd_config.d ] && SSH_PORT=$(grep -Ei '^\s*Port\s+' /etc/ssh/sshd_config.d/*.conf 2>/dev/null | head -1 | awk '{print $2}')
[[ "$SSH_PORT" =~ ^[0-9]+$ ]] || SSH_PORT=22

ufw allow 22/tcp comment 'SSH fallback'
ufw allow ${SSH_PORT}/tcp comment 'SSH'
if $DEPLOY_DUAL; then
    ufw allow ${V4_PORT}/tcp comment 'AnyTLS IPv4'
    ufw allow ${V4_PORT}/udp comment 'AnyTLS IPv4 UDP'
    ufw allow ${V6_PORT}/tcp comment 'AnyTLS IPv6'
    ufw allow ${V6_PORT}/udp comment 'AnyTLS IPv6 UDP'
else
    ufw allow ${ANYTLS_PORT}/tcp comment 'AnyTLS'
    ufw allow ${ANYTLS_PORT}/udp comment 'AnyTLS UDP'
fi
ufw --force enable
ufw reload

# ---------- 定时清理 ----------
echo "8. 配置定时清理..."
cat > /etc/cron.d/anytls-cleanup << 'CRONEOF'
7 7 * * 0 root /bin/bash -c 'apt-get clean && apt-get autoclean -y && apt-get autoremove -y && rm -rf /var/lib/apt/lists/* && journalctl --vacuum-time=5d --vacuum-size=30M && find /tmp /var/tmp -type f -mtime +7 -delete' >/dev/null 2>&1
CRONEOF
chmod 644 /etc/cron.d/anytls-cleanup

# ---------- 最终信息 ----------
echo -e "\n=============================="
echo " AnyTLS TLS 部署成功"
echo "=============================="
echo " 版本     : $VERSION"
echo " 证书     : $DOMAIN"
echo " 密码     : $ANYTLS_PASSWORD"
if $DEPLOY_DUAL; then
    echo "------------------------------"
    echo " IPv4 节点"
    echo " IP       : $IPV4"
    echo " 端口     : $V4_PORT"
    echo " URI      : anytls://${ANYTLS_PASSWORD}@${IPV4}:${V4_PORT}"
    echo "------------------------------"
    echo " IPv6 节点"
    echo " IP       : $IPV6"
    echo " 端口     : $V6_PORT"
    echo " URI      : anytls://${ANYTLS_PASSWORD}@[${IPV6}]:${V6_PORT}"
    echo "------------------------------"
    echo " 域名节点 (需 A/AAAA 均指向本机)"
    echo " 域名     : $DOMAIN"
    echo " 节点1    : anytls://${ANYTLS_PASSWORD}@${DOMAIN}:${V4_PORT}"
    echo " 节点2    : anytls://${ANYTLS_PASSWORD}@${DOMAIN}:${V6_PORT}"
else
    MAIN_IP=$([ "$IPV4" != "无" ] && echo "$IPV4" || echo "$IPV6")
    echo " IP       : $IPV4 (v4) / $IPV6 (v6)"
    echo " 端口     : $ANYTLS_PORT"
    echo " 模式     : $([ "$NET_MODE" = "4" ] && echo "IPv4 Only" || [ "$NET_MODE" = "6" ] && echo "IPv6 Only" || echo "Dual Stack")"
    echo " URI      : anytls://${ANYTLS_PASSWORD}@${DOMAIN}:${ANYTLS_PORT}"
fi
echo " TLS指纹 : $(openssl x509 -in $CERT_DIR/fullchain.crt -noout -fingerprint -sha256 | cut -d= -f2)"
echo "=============================="
