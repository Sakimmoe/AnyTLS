  local DEF_NAME=$(hostname 2>/dev/null || echo "AnyTLS")
  read -rp "请输入节点名称 [默认: ${DEF_NAME}]: " input_name
  local NAME=${input_name:-$DEF_NAME}

  read -rp "是否使用自己的域名并自动申请 Let's Encrypt 证书? [y/N]: " input_cert_mode
  if [[ "${input_cert_mode:-N}" =~ ^[Yy]$ ]]; then
    CERT_MODE="acme"
    read -rp "请输入你的域名 (必须已解析到本服务器，且 80/443 端口空闲): " TLS_DOMAIN
