#!/bin/bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

DOMAIN=${1:-}
ANYTLS_PORT=${2:-443}
ANYTLS_PASSWORD=${3:-kokonoeyukari}
NET_MODE=${4:-}

GITHUB_API="https://api.github.com/repos/anytls/anytls-go/releases/latest"

echo "=========================================="
echo " AnyTLS CA证书部署脚本"
echo "=========================================="

if [ "$EUID" -ne 0 ]; then
    echo "Error: 请使用 root 用户运行"
    exit 1
fi

if [ -z "$DOMAIN" ]; then
    echo "用法:"
    echo "bash anytls 域名 [端口] [密码] [模式]"
    echo "模式: dual / 4 / 6"
    exit 1
fi


echo "安装依赖..."

apt-get update -qq >/dev/null 2>&1 || true

apt-get install -y -qq \
wget unzip curl ufw iproute2 cron jq tar socat ca-certificates >/dev/null 2>&1 || true


echo "优化网络..."

grep -q "precedence ::ffff:0:0/96 100" /etc/gai.conf 2>/dev/null \
|| echo "precedence ::ffff:0:0/96 100" >> /etc/gai.conf


systemctl disable systemd-resolved --now >/dev/null 2>&1 || true
systemctl mask systemd-resolved >/dev/null 2>&1 || true


chattr -i /etc/resolv.conf >/dev/null 2>&1 || true
rm -f /etc/resolv.conf


cat >/etc/resolv.conf <<EOF
nameserver 1.1.1.1
nameserver 8.8.8.8
nameserver 2606:4700:4700::1111
nameserver 2001:4860:4860::8888
EOF


chattr +i /etc/resolv.conf >/dev/null 2>&1 || true


cat >/etc/sysctl.d/99-bbr.conf <<EOF
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
EOF


sysctl --system >/dev/null 2>&1 || true


echo "获取IP..."

IPV4=$(curl -4 -s --max-time 5 https://api.ipify.org || echo "无")
IPV6=$(curl -6 -s --connect-timeout 5 https://api64.ipify.org || echo "无")

MAIN_IP=$([ "$IPV4" != "无" ] && echo "$IPV4" || echo "$IPV6")


case "$NET_MODE" in
4)
    LISTEN_ADDR="0.0.0.0"
    ;;
6)
    LISTEN_ADDR="[::]"
    ;;
*)
    LISTEN_ADDR="[::]"
    ;;
esac


echo "申请Let's Encrypt证书..."

curl -sL https://get.acme.sh | sh -s email=admin@${DOMAIN} >/dev/null 2>&1 || true


~/.acme.sh/acme.sh \
--set-default-ca \
--server letsencrypt >/dev/null 2>&1 || true


if [ "$NET_MODE" = "4" ]; then

~/.acme.sh/acme.sh \
--issue \
-d ${DOMAIN} \
--standalone \
--listen-v4

elif [ "$NET_MODE" = "6" ]; then

~/.acme.sh/acme.sh \
--issue \
-d ${DOMAIN} \
--standalone \
--listen-v6

else

~/.acme.sh/acme.sh \
--issue \
-d ${DOMAIN} \
--standalone

fi


mkdir -p /etc/anytls


~/.acme.sh/acme.sh \
--installcert \
-d ${DOMAIN} \
--key-file /etc/anytls/server.key \
--fullchain-file /etc/anytls/server.crt


echo "下载AnyTLS..."


case "$(uname -m)" in
x86_64|amd64)
ARCH="amd64"
;;
aarch64|arm64)
ARCH="arm64"
;;
*)
echo "不支持架构"
exit 1
;;
esac


RELEASE_INFO=$(curl -s \
--connect-timeout 10 \
--max-time 20 \
${GITHUB_API})


VERSION=$(echo "$RELEASE_INFO" | jq -r '.tag_name')


if [ "$VERSION" = "null" ] || [ -z "$VERSION" ]; then
    echo "获取版本失败"
    exit 1
fi


ASSET_URL=$(echo "$RELEASE_INFO" \
| jq -r ".assets[].browser_download_url" \
| grep -i linux \
| grep -i ${ARCH} \
| grep -v sha256 \
| head -1)


if [ -z "$ASSET_URL" ]; then
    echo "没有找到AnyTLS文件"
    exit 1
fi


TMP=$(mktemp -d)


wget -q \
-O ${TMP}/anytls.pkg \
"$ASSET_URL"


rm -f /usr/local/bin/anytls-server


if [[ "$ASSET_URL" == *.tar.gz ]]; then

tar -xf ${TMP}/anytls.pkg -C ${TMP}

elif [[ "$ASSET_URL" == *.zip ]]; then

unzip -q -o ${TMP}/anytls.pkg -d ${TMP}

else

cp ${TMP}/anytls.pkg ${TMP}/anytls-server

fi


FILE=$(find ${TMP} -type f -name "anytls-server" | head -1)


if [ -z "$FILE" ]; then
    echo "安装失败"
    exit 1
fi


cp "$FILE" /usr/local/bin/anytls-server

chmod +x /usr/local/bin/anytls-server

rm -rf ${TMP}



echo "创建服务..."


cat >/etc/systemd/system/anytls.service <<EOF
[Unit]
Description=AnyTLS Server CA
After=network.target

[Service]
Type=simple
LimitNOFILE=65535

ExecStart=/usr/local/bin/anytls-server \
-l ${LISTEN_ADDR}:${ANYTLS_PORT} \
-p ${ANYTLS_PASSWORD} \
-cert /etc/anytls/server.crt \
-key /etc/anytls/server.key

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF


systemctl daemon-reload

systemctl enable anytls >/dev/null 2>&1 || true

systemctl restart anytls


sleep 2


if ! systemctl is-active --quiet anytls; then

echo "AnyTLS启动失败"

journalctl -u anytls -n 30 --no-pager

exit 1

fi



echo "配置防火墙..."


systemctl enable --now ufw >/dev/null 2>&1 || true


ufw --force reset >/dev/null 2>&1 || true

ufw default deny incoming >/dev/null 2>&1 || true

ufw default allow outgoing >/dev/null 2>&1 || true


SSH_PORT=$(grep -Ei '^\s*Port\s+' /etc/ssh/sshd_config 2>/dev/null \
| head -1 \
| awk '{print $2}' || echo 22)


if ! [[ "$SSH_PORT" =~ ^[0-9]+$ ]]; then
SSH_PORT=22
fi


ufw allow 22/tcp >/dev/null 2>&1 || true
ufw allow ${SSH_PORT}/tcp >/dev/null 2>&1 || true

ufw allow 80/tcp >/dev/null 2>&1 || true

ufw allow ${ANYTLS_PORT}/tcp >/dev/null 2>&1 || true


ufw --force enable >/dev/null 2>&1 || true

ufw reload >/dev/null 2>&1 || true



echo "配置证书自动续期..."


~/.acme.sh/acme.sh \
--install-cert \
-d ${DOMAIN} \
--key-file /etc/anytls/server.key \
--fullchain-file /etc/anytls/server.crt \
--reloadcmd "systemctl restart anytls"



echo "配置清理任务..."


cat >/etc/cron.d/anytls-cleanup <<'EOF'
7 7 * * 0 root apt-get clean >/dev/null 2>&1
EOF


chmod 644 /etc/cron.d/anytls-cleanup



echo

echo "=========================================="
echo " AnyTLS部署完成"
echo "=========================================="

echo "域名 : ${DOMAIN}"
echo "IPv4 : ${IPV4}"
echo "IPv6 : ${IPV6}"
echo "端口 : ${ANYTLS_PORT}"
echo "密码 : ${ANYTLS_PASSWORD}"
echo "版本 : ${VERSION}"
echo "监听 : ${LISTEN_ADDR}"

echo

echo "节点:"
echo "anytls://${ANYTLS_PASSWORD}@${DOMAIN}:${ANYTLS_PORT}"

echo "=========================================="
